# ── Local identity ─────────────────────────────────────────────
# Production (NODE_ENV=production) refuses to start if this is true/1/yes/on.
# Dev is unchanged. Leave it false on any host you can reach.
ENSEMBLE_DEV_AUTH_BYPASS=false
ENSEMBLE_DEV_USER_ID=local
# Desk switcher and developer routes (marketplace). Ignored in production;
# hub-api also refuses to start if this is on while NODE_ENV=production.
# ENSEMBLE_DEV_TOOLS=1
# Signup is open by default. closed stops new accounts but not existing logins.
# allowlist requires matching emails / *@domain patterns and denies an empty list.
ENSEMBLE_SIGNUP_MODE=open
# ENSEMBLE_SIGNUP_ALLOWLIST=you@example.com,*@school.edu
# Hosted operator accounts must have a verified email matching this exact list.
# Only they may use host model/connector credentials or host filesystem execution.
# ENSEMBLE_OPERATOR_EMAILS=operator@example.com
# off always disables terminal access; hosted production defaults to off.
# ENSEMBLE_TERMINAL=off
# Hosted per-user limits; positive integers, invalid values fail startup.
# ENSEMBLE_MAX_CONNECTORS=5
# ENSEMBLE_MAX_JOBS_PER_DAY=50
# ENSEMBLE_MAX_DATASET_BYTES=104857600
# ENSEMBLE_MAX_DOCUMENT_BYTES=104857600
ENSEMBLE_TIMEZONE=Asia/Kolkata
ENSEMBLE_AUTONOMY_LEVEL=assist

# ── Public account login (separate from connector OAuth) ─────────
# Callback: HUB_API_PUBLIC_URL/api/auth/oauth/<provider>/callback.
# Set both values to expose a provider on the login/signup screen.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# Required for hosted email/password signup and account recovery.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=Ensemble <no-reply@mail.example.com>
# Both required for hosted email signup. Site key is public; secret never is.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Infra ──────────────────────────────────────────────────────
# 127.0.0.1, not localhost. On a Mac, localhost often resolves to ::1 first,
# and Colima / Docker Desktop refuse to publish that address.
DATABASE_URL=postgresql://ensemble:ensemble@127.0.0.1:5432/ensemble
REDIS_URL=redis://127.0.0.1:6379
# Loopback only. hub-api honours this value. 0.0.0.0 publishes the API on every interface.
HUB_API_HOST=127.0.0.1
HUB_API_PORT=4000
# Exact browser origin of the site. Production requires https and refuses to start otherwise.
# CORS (including SSE) allows this origin, with credentials, and the localhost/127.0.0.1 twin. Never *.
HUB_WEB_ORIGIN=http://localhost:3000
# Public hub-api origin baked into the browser at `next build`.
# SSE uses this directly (Vercel cuts a proxied stream at about 120s). Other /api calls still use the rewrite.
# A production build fails if this is unset. Dev defaults to http://127.0.0.1:4000.
# NEXT_PUBLIC_HUB_API=http://127.0.0.1:4000
# Parent domain for the session cookie when the site and the API are different hosts
# (app.example.com and api.example.com → .example.com). Leave unset for one host, including local dev.
# Production refuses to start when the two public origins cannot share a cookie.
# ENSEMBLE_COOKIE_DOMAIN=.example.com
# Public https origin for Open Graph and Twitter image URLs (metadataBase).
# Leave blank until that origin exists. Never hardcode it in the app.
# Split host: https://app.example.com. Single host: the same origin as the site.
NEXT_PUBLIC_SITE_URL=
# Service token shared with agent-runtime. "dev-internal-token" is a well-known
# default: hub-api logs a warning in dev, and the Context Bridge refuses it.
# NODE_ENV=production refuses to start on this default or an example value
# (change-me, example-token, …). Generate a private value: openssl rand -hex 32
# Editors should not use this. Create a personal ens_ token in
# Settings → Editors & agents and export it as ENSEMBLE_BRIDGE_TOKEN.
ENSEMBLE_INTERNAL_TOKEN=dev-internal-token
# Personal token for apps/context-bridge (read-only MCP). Starts with ens_.
# Create a read-only key in the Hub at Connect your apps.
ENSEMBLE_BRIDGE_TOKEN=
# Set true only for a local demo that intentionally uses the default internal token.
# Production refuses to start if this is on.
ENSEMBLE_BRIDGE_ALLOW_DEFAULT_INTERNAL_TOKEN=false

# ── Workspace ──────────────────────────────────────────────────
ENSEMBLE_WORKSPACE_ROOT=~/ensemble-workspace
ENSEMBLE_WORKSPACE_IMAGE=ensemble-workspace:local

# ── Logging ────────────────────────────────────────────────────
ENSEMBLE_LOG_LEVEL=info
ENSEMBLE_LOG_TO_FILE=false
ENSEMBLE_LOG_RETENTION_DAYS=14

# ── Feature flags (comma-separated) ────────────────────────────
ENSEMBLE_FEATURES=

# ── LLM providers (any subset; missing ones are skipped) ───────
# Keys can also be pasted in Settings → Models (stored encrypted, per account).
# Gemini: create a key at https://aistudio.google.com/apikey
# That key is GOOGLE_API_KEY. It does not connect Gmail.
# A student Gemini Pro trial in the Gemini app is a separate product.
ENSEMBLE_LLM_PROVIDER=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=
COPILOT_API_BASE=https://api.githubcopilot.com
COPILOT_API_KEY=
GITHUB_TOKEN=

ENSEMBLE_MODEL_PLANNER=gemini-3.5-flash-lite
ENSEMBLE_MODEL_DRAFTER=gemini-3.5-flash-lite
ENSEMBLE_MODEL_CLASSIFIER=gemini-3.5-flash-lite
ENSEMBLE_MODEL_CODER=gemini-3.5-flash-lite
ENSEMBLE_EMBEDDING_MODEL=text-embedding-3-large
ENSEMBLE_MODEL_CREDITS=

# ── Connectors (OAuth per source; leave blank until connected) ─
# These are not the Gemini key. A future signup page will store the
# resulting tokens in oauth_tokens instead of asking for these env vars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional: GitHub OAuth app for "Sign in with GitHub" (a pasted token also works)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server-side fallbacks; each person can connect their own in Settings
SLACK_USER_TOKEN=
LINEAR_API_KEY=
# Public origin of hub-api. OAuth redirects, and the production check that the
# session cookie can be shared with HUB_WEB_ORIGIN. Same host as the site, or https://api.example.com.
HUB_API_PUBLIC_URL=http://localhost:4000
# 32 random bytes, base64. Left blank, one is generated in .ensemble/secret.key.
# Set it yourself before production and back it up. decrypt() rejects plaintext;
# if old rows are not v1: ciphertext, run `pnpm secrets:encrypt` once with this key.
ENSEMBLE_SECRET_KEY=

# ── Plots ──────────────────────────────────────────────────────
# Warm matplotlib runner. How many plot exports may run at once.
# Extra exports wait. Set 1 on a small VM.
ENSEMBLE_PLOT_CONCURRENCY=2
# Interpreter for that runner. Unset: the agent runtime's own Python when the
# runtime serves plots, or python3 on PATH for the desktop sidecar.
# Point this at a Python without matplotlib to check the install error.
# ENSEMBLE_PYTHON=

# ── Rate limits (hub-api, in memory, one process) ──────────────
# A limit of 0 turns that bucket off. Windows are seconds.
# Login, signup, assistant/model routes (turn, /api/models, model-keys, test),
# and token minting (API keys, MCP keys, and future app sign-in tokens).
ENSEMBLE_RATE_LOGIN_LIMIT=30
ENSEMBLE_RATE_LOGIN_WINDOW_SEC=900
ENSEMBLE_RATE_SIGNUP_LIMIT=60
ENSEMBLE_RATE_SIGNUP_WINDOW_SEC=3600
ENSEMBLE_RATE_EMAIL_LIMIT=5
ENSEMBLE_RATE_EMAIL_WINDOW_SEC=3600
# CLI device login (per address) and hosted MCP (per user).
ENSEMBLE_RATE_CLI_START_LIMIT=10
ENSEMBLE_RATE_CLI_START_WINDOW_SEC=600
ENSEMBLE_RATE_CLI_TOKEN_LIMIT=120
ENSEMBLE_RATE_CLI_TOKEN_WINDOW_SEC=60
ENSEMBLE_RATE_CLI_APPROVE_LIMIT=30
ENSEMBLE_RATE_CLI_APPROVE_WINDOW_SEC=600
ENSEMBLE_RATE_MCP_LIMIT=240
ENSEMBLE_RATE_MCP_WINDOW_SEC=60
ENSEMBLE_RATE_MODEL_LIMIT=120
ENSEMBLE_RATE_MODEL_WINDOW_SEC=60
ENSEMBLE_RATE_TOKEN_LIMIT=20
ENSEMBLE_RATE_TOKEN_WINDOW_SEC=900

# ── Readiness (GET /health/ready and GET /health?deep=1) ────────
# Per-probe timeout in milliseconds. Scheduler is stale after this many seconds
# without a finished tick. ENSEMBLE_SCHEDULER=off does not fail the check.
ENSEMBLE_HEALTH_TIMEOUT_MS=800
ENSEMBLE_HEALTH_SCHEDULER_STALE_SEC=180
