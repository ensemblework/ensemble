# Copy to /etc/ensemble.env and then: chmod 600 /etc/ensemble.env
# Placeholders only. Do not commit a filled copy.
# Generate the two secrets on the VM and keep them in a password manager:
#   openssl rand -base64 32

# Required. Enables the hosted account and execution safety checks.
NODE_ENV=production
ENSEMBLE_SIGNUP_MODE=open
# Exact verified operator emails; public users bring their own model keys.
# ENSEMBLE_OPERATOR_EMAILS=operator@example.com
ENSEMBLE_TERMINAL=off
# Positive per-user limits (defaults shown); daily job usage is UTC and
# survives deleting tasks/jobs. Dataset bytes include compressed tables/originals.
# ENSEMBLE_MAX_CONNECTORS=25
# ENSEMBLE_MAX_JOBS_PER_DAY=50
# ENSEMBLE_MAX_DATASET_BYTES=104857600
# Files (docs/32): files per account and their combined bytes (removed files do not
# count), plus a guard on every stored original on this server (its database or blob container).
# ENSEMBLE_MAX_DOCUMENTS=10
# ENSEMBLE_MAX_DOCUMENT_BYTES=52428800
# ENSEMBLE_FILES_TOTAL_MAX_BYTES=10737418240
# Where file originals live (docs/32 §2). Unset or database: on the row in Postgres.
# azure-blob: a private Azure Blob container; production refuses to start without the
# connection string (Storage account → Access keys → Connection string).
# ENSEMBLE_FILE_STORAGE=azure-blob
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=ensemble-files
# ── Included AI (docs/33): models the operator runs on Azure AI Foundry ─────
# Every verified account gets Ensemble credits a month to spend on them; nobody
# needs a key. Off until both Azure values are set. Deployment names must equal
# the model ids: gpt-6-luna, deepseek-v4-flash, gpt-6.1-sol, grok-4.7.
# AZURE_FOUNDRY_RESOURCE=ensemble-ai
# AZURE_FOUNDRY_API_KEY=
# Comma list of the deployments to offer (default: those four), or off. An
# Azure free account has quota only for gpt-5-mini and gpt-4.1-mini: list those.
# ENSEMBLE_INCLUDED_MODELS=gpt-6-luna,deepseek-v4-flash,gpt-6.1-sol,grok-4.7
# Credits per account per UTC calendar month (1,000 credits = $1 of model cost).
# ENSEMBLE_INCLUDED_MONTHLY_CREDITS=20000
# Model cost across every account per month, in USD. At this ceiling every
# included call stops until the 1st, even for accounts with credits left.
# ENSEMBLE_INCLUDED_TOTAL_MONTHLY_USD=180
# Reply cap per call, reasoning included. Azure counts it against each
# deployment's tokens-per-minute quota when a request starts.
# ENSEMBLE_INCLUDED_MAX_OUTPUT_TOKENS=16000
# Optional kill switch: ENSEMBLE_SIGNUP_MODE=closed. For restricted signup,
# choose allowlist and set ENSEMBLE_SIGNUP_ALLOWLIST to emails / *@domain.

# Public login OAuth clients. Callback: HUB_API_PUBLIC_URL/api/auth/oauth/<provider>/callback
# The Google, Microsoft and GitHub connectors reuse these apps unless the
# connector clients below are set; add HUB_API_PUBLIC_URL/api/connectors/<provider>/callback
# to the same app. A GitHub OAuth App has one callback: set it to HUB_API_PUBLIC_URL/api.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# Required for public email/password signup and password reset.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=Ensemble <no-reply@mail.example.com>
# Required for public email signup; widget hostname is the Hub, not the API.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Connector OAuth apps (optional; each person connects their own account).
# Redirect URI: HUB_API_PUBLIC_URL/api/connectors/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PROJECT_NUMBER=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# DOCUSIGN_CLIENT_ID=
# DOCUSIGN_CLIENT_SECRET=
# DOCUSIGN_ENV=demo
# Dropbox, Box, Xero and Discord connector apps (redirect URI: HUB_API_PUBLIC_URL/api/connectors/<provider>/callback).
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Older Xero apps that still use the broad scopes can list them here, space-separated.
# XERO_SCOPES=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# The bot that reads the channels of servers people add it to (Message Content intent on).
# DISCORD_BOT_TOKEN=
# Clients registered for vendor MCP servers that do not let apps register themselves
# (redirect URI: HUB_API_PUBLIC_URL/api/mcp-connections/callback). Settings → Connections can save them too.
# HUBSPOT_MCP_CLIENT_ID=
# HUBSPOT_MCP_CLIENT_SECRET=
# ASANA_MCP_CLIENT_ID=
# ASANA_MCP_CLIENT_SECRET=
# SLACK_MCP_CLIENT_ID=
# SLACK_MCP_CLIENT_SECRET=
# DROPBOX_MCP_CLIENT_ID=
# DROPBOX_MCP_CLIENT_SECRET=
# Connector reads are manual. No background artifact fetching.

# One of these two. Delete the other.
# No query string. Prisma-only parameters (connection_limit, pool_timeout, pgbouncer,
# schema, socket_timeout) make the agent's psycopg.connect reject the URL.
# Postgres on the VM (compose user, loopback only). This is the default:
DATABASE_URL=postgresql://ensemble:ensemble@127.0.0.1:5432/ensemble
# Supabase session pooler, with setup.sh --no-local-postgres (copy the host from the Connect dialog):
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Workspace, matplotlib cache, and the Mac-remote state file. The units set the same paths.
ENSEMBLE_WORKSPACE_ROOT=/var/lib/ensemble/workspace
ENSEMBLE_MPLCONFIGDIR=/var/cache/ensemble/matplotlib
ENSEMBLE_REMOTE_STATE_DIR=/var/lib/ensemble/remote

# Local Redis. setup.sh replaces PASSWORD when this line is still the placeholder.
# An Upstash rediss:// URL is used only with setup.sh --no-local-redis (or ENSEMBLE_LOCAL_REDIS=0).
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379
HUB_API_HOST=127.0.0.1
HUB_API_PORT=4000
# Required on the VM. Exact value, no trailing slash. CORS compares this origin
# exactly, and a trailing slash silently breaks the live stream.
HUB_WEB_ORIGIN=https://app.ensemblework.com
# Required on the VM. Production refuses to start when this cannot share a
# cookie with HUB_WEB_ORIGIN. setup.sh and update.sh refuse an empty value,
# and use its host as Caddy's site address. https://<host>, no port or path.
HUB_API_PUBLIC_URL=https://api.ensemblework.com
# Required on the VM.
ENSEMBLE_COOKIE_DOMAIN=ensemblework.com
AGENT_RUNTIME_URL=http://127.0.0.1:5055
AGENT_RUNTIME_PORT=5055
# Production refuses this placeholder. Replace it before the first start.
ENSEMBLE_INTERNAL_TOKEN=replace-me
# Must decode to 32 bytes. Replace it. An empty value makes the process write .ensemble/secret.key.
ENSEMBLE_SECRET_KEY=replace-me
ENSEMBLE_SCHEDULER=on
# The branch this VM runs. deploy.yml moves `production` only after CI passes on main.
ENSEMBLE_DEPLOY_BRANCH=production
# on: ensemble-autodeploy.timer checks that branch every minute and runs update.sh
# when it moves. off: deploy only by running update.sh yourself.
ENSEMBLE_AUTODEPLOY=on
# Required on this VM. Unset means the server accepts unassigned code jobs.
ENSEMBLE_SERVER_RUNNER=off
# One plot export at a time on a 4 GB VM. Extra exports wait. Default is 2.
ENSEMBLE_PLOT_CONCURRENCY=1
# Per-child address-space budget on this Linux VM, in MiB (64-2048).
# A Mac uses a sampled resident-memory budget instead, not a hard ceiling.
ENSEMBLE_PLOT_MEMORY_MIB=2048
# Optional. Unset keeps the defaults in lib/rate-limit.ts. 0 turns that bucket off.
# ENSEMBLE_RATE_LOGIN_LIMIT=30
# ENSEMBLE_RATE_LOGIN_WINDOW_SEC=900
# ENSEMBLE_RATE_SIGNUP_LIMIT=60
# ENSEMBLE_RATE_SIGNUP_WINDOW_SEC=3600
# ENSEMBLE_RATE_EMAIL_LIMIT=5
# ENSEMBLE_RATE_EMAIL_WINDOW_SEC=3600
# ENSEMBLE_RATE_CLI_START_LIMIT=10
# ENSEMBLE_RATE_CLI_START_WINDOW_SEC=600
# ENSEMBLE_RATE_CLI_TOKEN_LIMIT=120
# ENSEMBLE_RATE_CLI_TOKEN_WINDOW_SEC=60
# ENSEMBLE_RATE_CLI_APPROVE_LIMIT=30
# ENSEMBLE_RATE_CLI_APPROVE_WINDOW_SEC=600
# ENSEMBLE_RATE_MCP_LIMIT=240
# ENSEMBLE_RATE_MCP_WINDOW_SEC=60
# ENSEMBLE_RATE_TOKEN_LIMIT=20
# ENSEMBLE_RATE_TOKEN_WINDOW_SEC=900
# ENSEMBLE_RATE_MODEL_LIMIT=120
# ENSEMBLE_RATE_MODEL_WINDOW_SEC=60
# ENSEMBLE_RATE_DEVICE_LIMIT=120
# ENSEMBLE_RATE_DEVICE_WINDOW_SEC=60
# Optional readiness. 0 or blank keeps the default.
# ENSEMBLE_HEALTH_TIMEOUT_MS=800
# ENSEMBLE_HEALTH_SCHEDULER_STALE_SEC=180

# ── Home server (infra/deploy/home/setup.sh) ────────────────────────────────
# Copy this file to ~/ensemble-host/ensemble.env (chmod 600) and change these lines.
# Ports differ from pnpm dev (4000, 5055, 5432, 6379) so both can run on one machine;
# compose.yml publishes Postgres and Redis on the ports in these two URLs.
# REDIS_URL needs a password; any long random one (openssl rand -hex 24).
# DATABASE_URL=postgresql://ensemble:ensemble@127.0.0.1:15432/ensemble
# REDIS_URL=redis://:PASSWORD@127.0.0.1:16379
# HUB_API_PORT=14000
# HUB_API_URL=http://127.0.0.1:14000
# AGENT_RUNTIME_PORT=15055
# AGENT_RUNTIME_URL=http://127.0.0.1:15055
# ENSEMBLE_WORKSPACE_ROOT=/home/<user>/ensemble-host/state/workspace
# ENSEMBLE_MPLCONFIGDIR=/home/<user>/ensemble-host/cache/matplotlib
# ENSEMBLE_REMOTE_STATE_DIR=/home/<user>/ensemble-host/state/remote
# The Cloudflare tunnel that carries HUB_API_PUBLIC_URL's host (its <id>.json goes in
# ~/ensemble-host/cloudflared/). Extra hosts, space-separated, get the same route.
# ENSEMBLE_TUNNEL_ID=
# ENSEMBLE_TUNNEL_EXTRA_HOSTS=
# Nightly backups also go to this blob container when AZURE_STORAGE_CONNECTION_STRING is set.
# ENSEMBLE_BACKUP_CONTAINER=ensemble-backups
