# Copy to /etc/ensemble.env and then: chmod 600 /etc/ensemble.env
# Placeholders only. Do not commit a filled copy.
# Generate the two secrets on the VM and keep them in a password manager:
#   openssl rand -base64 32

# Required. Enables the hosted account and execution safety checks.
NODE_ENV=production
ENSEMBLE_SIGNUP_MODE=open
# Exact verified operator emails; public users bring their own model keys.
# ENSEMBLE_OPERATOR_EMAILS=operator@example.com
ENSEMBLE_TERMINAL=off
# Positive per-user limits (defaults shown); daily job usage is UTC and
# survives deleting tasks/jobs. Dataset bytes include compressed tables/originals.
# ENSEMBLE_MAX_CONNECTORS=5
# ENSEMBLE_MAX_JOBS_PER_DAY=50
# ENSEMBLE_MAX_DATASET_BYTES=104857600
# Uploaded document originals (including soft-deleted retained rows) are separate.
# ENSEMBLE_MAX_DOCUMENT_BYTES=104857600
# Optional kill switch: ENSEMBLE_SIGNUP_MODE=closed. For restricted signup,
# choose allowlist and set ENSEMBLE_SIGNUP_ALLOWLIST to emails / *@domain.

# Public login OAuth clients, NOT connector OAuth clients.
# Callback: HUB_API_PUBLIC_URL/api/auth/oauth/<provider>/callback
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# Required for public email/password signup and password reset.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=Ensemble <no-reply@mail.example.com>
# Required for public email signup; widget hostname is the Hub, not the API.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# One of these two. Delete the other.
# No query string. Prisma-only parameters (connection_limit, pool_timeout, pgbouncer,
# schema, socket_timeout) make the agent's psycopg.connect reject the URL.
# Postgres on the VM (compose user, loopback only). This is the default:
DATABASE_URL=postgresql://ensemble:ensemble@127.0.0.1:5432/ensemble
# Supabase session pooler, with setup.sh --no-local-postgres (copy the host from the Connect dialog):
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Workspace, matplotlib cache, and the Mac-remote state file. The units set the same paths.
ENSEMBLE_WORKSPACE_ROOT=/var/lib/ensemble/workspace
ENSEMBLE_MPLCONFIGDIR=/var/cache/ensemble/matplotlib
ENSEMBLE_REMOTE_STATE_DIR=/var/lib/ensemble/remote

# Local Redis. setup.sh replaces PASSWORD when this line is still the placeholder.
# An Upstash rediss:// URL is used only with setup.sh --no-local-redis (or ENSEMBLE_LOCAL_REDIS=0).
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379
HUB_API_HOST=127.0.0.1
HUB_API_PORT=4000
# Required on the VM. Exact value, no trailing slash. CORS compares this origin
# exactly, and a trailing slash silently breaks the live stream.
HUB_WEB_ORIGIN=https://app.ensemblework.com
# Required on the VM. Production refuses to start when this cannot share a
# cookie with HUB_WEB_ORIGIN. setup.sh and update.sh refuse an empty value,
# and use its host as Caddy's site address. https://<host>, no port or path.
HUB_API_PUBLIC_URL=https://api.ensemblework.com
# Required on the VM.
ENSEMBLE_COOKIE_DOMAIN=ensemblework.com
AGENT_RUNTIME_URL=http://127.0.0.1:5055
AGENT_RUNTIME_PORT=5055
# Production refuses this placeholder. Replace it before the first start.
ENSEMBLE_INTERNAL_TOKEN=replace-me
# Must decode to 32 bytes. Replace it. An empty value makes the process write .ensemble/secret.key.
ENSEMBLE_SECRET_KEY=replace-me
ENSEMBLE_SCHEDULER=on
# The branch this VM runs. deploy.yml moves `production` only after CI passes on main.
ENSEMBLE_DEPLOY_BRANCH=production
# on: ensemble-autodeploy.timer checks that branch every minute and runs update.sh
# when it moves. off: deploy only by running update.sh yourself.
ENSEMBLE_AUTODEPLOY=on
# Required on this VM. Unset means the server accepts unassigned code jobs.
ENSEMBLE_SERVER_RUNNER=off
# One plot export at a time on a 4 GB VM. Extra exports wait. Default is 2.
ENSEMBLE_PLOT_CONCURRENCY=1
# Per-child address-space budget on this Linux VM, in MiB (64-2048).
# A Mac uses a sampled resident-memory budget instead, not a hard ceiling.
ENSEMBLE_PLOT_MEMORY_MIB=2048
# Optional. Unset keeps the defaults in lib/rate-limit.ts. 0 turns that bucket off.
# ENSEMBLE_RATE_LOGIN_LIMIT=30
# ENSEMBLE_RATE_LOGIN_WINDOW_SEC=900
# ENSEMBLE_RATE_SIGNUP_LIMIT=60
# ENSEMBLE_RATE_SIGNUP_WINDOW_SEC=3600
# ENSEMBLE_RATE_EMAIL_LIMIT=5
# ENSEMBLE_RATE_EMAIL_WINDOW_SEC=3600
# ENSEMBLE_RATE_CLI_START_LIMIT=10
# ENSEMBLE_RATE_CLI_START_WINDOW_SEC=600
# ENSEMBLE_RATE_CLI_TOKEN_LIMIT=120
# ENSEMBLE_RATE_CLI_TOKEN_WINDOW_SEC=60
# ENSEMBLE_RATE_CLI_APPROVE_LIMIT=30
# ENSEMBLE_RATE_CLI_APPROVE_WINDOW_SEC=600
# ENSEMBLE_RATE_MCP_LIMIT=240
# ENSEMBLE_RATE_MCP_WINDOW_SEC=60
# ENSEMBLE_RATE_TOKEN_LIMIT=20
# ENSEMBLE_RATE_TOKEN_WINDOW_SEC=900
# ENSEMBLE_RATE_MODEL_LIMIT=120
# ENSEMBLE_RATE_MODEL_WINDOW_SEC=60
# ENSEMBLE_RATE_DEVICE_LIMIT=120
# ENSEMBLE_RATE_DEVICE_WINDOW_SEC=60
# Optional readiness. 0 or blank keeps the default.
# ENSEMBLE_HEALTH_TIMEOUT_MS=800
# ENSEMBLE_HEALTH_SCHEDULER_STALE_SEC=180
