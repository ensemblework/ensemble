{
  "name": "@ensemble/context-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@ensemble/shared-types": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  }
}
