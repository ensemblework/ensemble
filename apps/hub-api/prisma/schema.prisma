// Domain model: docs/00 §7 and the module docs 02–07.
// Logical grouping is table-name prefixes in public, not real Postgres schemas,
// so Prisma, pgvector, and audit triggers share one migration history.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, uuidossp(map: "uuid-ossp")]
}

// ── enums (mirrored in packages/shared-types/src/enums.ts) ─────────────────

enum TaskSource {
  email
  teams
  slack
  meeting
  github
  manual
  notion
  linear
  jira
  trello
  asana
  todoist
  clickup
  monday
  other
}

enum TaskOwner {
  me
  agent
  unassigned
}

enum TaskStatus {
  proposed
  todo
  in_progress
  waiting_approval
  blocked
  done
  dropped
}

enum Priority {
  critical
  p0
  p1
  p2
}

enum TaskComplexity {
  easy
  medium
  high
  max
}

enum ComplexitySource {
  agent
  me
  default
}

enum Actor {
  agent
  me
  system
}

enum StepStatus {
  pending
  running
  done
  failed
  needs_approval
  skipped
}

enum RunOutcome {
  success
  failed
  cancelled
  needs_info
  waiting_approval
}

enum ApprovalKind {
  send_email
  open_pr
  post_teams
  other
}

enum ApprovalDecision {
  approved
  edited
  rejected
}

enum AutonomyLevel {
  assist
  supervised
  autonomous
}

enum ArtifactKind {
  email
  chat_msg
  channel_msg
  event
  transcript
  transcript_segment
  file
  pr
  pr_comment
  commit
  issue
  meeting_note
}

enum RepoRole {
  owner
  maintainer
  contributor
}

enum RepoProvider {
  github
  other
}

enum ProjectStatus {
  active
  done
}

enum DeliverableStatus {
  upcoming
  completed
}

enum WorkspaceJobStatus {
  queued
  running
  stopping
  waiting_approval
  blocked
  succeeded
  failed
  cancelled
  /// A paired device took the job and holds its lease (docs/25 §4.2).
  claimed
  /// The desktop marks a job it was running when it quit. A device lease that ran out uses the same value. Never re-queued; the person picks Run again.
  interrupted
}

enum SkillProvenance {
  bootstrap
  provisional
  mined
  declared
}

// ── core — tasks, plans, runs, approvals ──────────────────────────────────

model Task {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  title             String
  description       String           @default("")
  notes             String           @default("")
  boardOrder        Float            @default(0) @map("board_order")
  todayFocus        String           @default("auto") @map("today_focus")
  skillIds          String[]         @default([]) @map("skill_ids")
  sourceKind        TaskSource       @default(manual) @map("source_kind")
  sourceRef         String           @default("") @map("source_ref")
  sourceUrl         String?          @map("source_url")
  excerpt           String?
  owner             TaskOwner        @default(unassigned)
  status            TaskStatus       @default(proposed)
  /// When owner is "me" in a shared space: which person. Null means the space's owner.
  assigneeAccountId String?          @map("assignee_account_id")
  priority          Priority         @default(p1)
  /// Orthogonal to priority: an urgent easy task is still easy.
  complexity        TaskComplexity   @default(medium)
  /// `me` is pinned: nothing re-infers over an explicit choice.
  complexitySource  ComplexitySource @default(agent) @map("complexity_source")
  autonomy          AutonomyLevel    @default(assist)
  due               DateTime?
  projectId         String?          @map("project_id")
  repoId            String?          @map("repo_id")
  workItemId        String?          @map("work_item_id")
  deliverableId     String?          @map("deliverable_id")
  people            String[]         @default([])
  rationale         String?
  confidence        Float?
  agentSuitability  Float?           @map("agent_suitability")
  taskType          String?          @map("task_type")
  /// Minutes or a score. The widget config says which. Not a time tracker.
  measure           Int?
  estimate          String?
  snoozedUntil      DateTime?        @map("snoozed_until")
  /// "Still relevant?" stays quiet until this instant. Not a due-date snooze.
  nudgePausedUntil  DateTime?        @map("nudge_paused_until")
  blockedQuestion   Json?            @map("blocked_question")
  createdBy         Actor            @default(agent) @map("created_by")
  completedAt       DateTime?        @map("completed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  /// Completed rows with pinned = true are kept past the completed-item window.
  pinned            Boolean          @default(false)
  startsAt          DateTime?        @map("starts_at")
  dependsOn         String[]         @default([]) @map("depends_on")
  matterStage       String?          @map("matter_stage")
  court             String?
  orderDate         DateTime?        @map("order_date")
  subject           String?
  weight            Float?
  wordCount         Int?             @map("word_count")
  pipelineStage     String?          @map("pipeline_stage")
  /// Limitation Act period, such as 30d or 3m. The due date is computed, not stored.
  limitationRule    String?          @map("limitation_rule")
  /// Free-form tags. Imports bring labels, tags and multi-selects here.
  labels            String[]         @default([])
  /// Set by importers and connectors so running an import again updates rather than duplicates.
  externalSource    String?          @map("external_source")
  externalId        String?          @map("external_id")
  /// The meeting an action item came from (meeting-notes connectors).
  meetingNoteId     String?          @map("meeting_note_id")

  planSteps     PlanStep[]
  runs          Run[]
  transitions   TaskTransition[]
  workspaces    WorkspaceSession[]
  workspaceJobs WorkspaceJob[]
  handoffs      AgentHandoff[]
  page          TaskPage?
  discussions   PageDiscussion[]
  artifacts     Artifact[]
  deliverable   Deliverable?       @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repo          Repo?              @relation(fields: [repoId], references: [id], onDelete: SetNull)
  meetingNote   MeetingNote?       @relation(fields: [meetingNoteId], references: [id], onDelete: SetNull)

  @@unique([userId, externalSource, externalId])
  @@index([userId, status])
  @@index([meetingNoteId])
  @@index([userId, owner])
  @@index([userId, createdAt])
  @@index([userId, status, boardOrder])
  @@index([userId, due])
  @@index([assigneeAccountId])
  @@index([userId, deletedAt])
  @@index([userId, completedAt])
  @@index([userId, taskType], map: "tasks_user_id_task_type_idx")
  @@index([userId, orderDate], map: "tasks_user_id_order_date_idx")
  @@map("tasks")
}

model TaskPage {
  boardId         String?           @map("board_id")
  boardColumnId   String?           @map("board_column_id")
  boardOrder      Float             @default(0) @map("board_order")
  board           PageBoard?        @relation(fields: [boardId], references: [id], onDelete: SetNull)
  historySavedAt  DateTime?         @map("history_saved_at")
  editorAccountId String?           @map("editor_account_id")
  versions        PageRevision[]
  parentId        String?           @map("parent_id")
  parent          TaskPage?         @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        TaskPage[]        @relation("PageChildren")
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  /// Null for a standalone note. Linked pages keep the task they belong to.
  taskId          String?           @unique @map("task_id")
  /// Standalone notes use this title. Linked pages keep the task title.
  title           String            @default("")
  revision        Int               @default(1)
  content         Json?
  annotations     Json              @default("[]")
  notesSnapshot   String            @default("") @map("notes_snapshot")
  /// Plain title and body. NULL means not indexed yet; a save or the startup backfill fills it.
  searchText      String?           @map("search_text")
  externalSource  String?           @map("external_source")
  externalId      String?           @map("external_id")
  /// The file this page was converted from.
  sourceFileId    String?           @map("source_file_id")
  /// The live-editing authority that wrote `content` last (src/pages/collab.ts): its epoch and version, valid while `revision` equals `collabRevision`.
  collabEpoch     String?           @map("collab_epoch")
  collabVersion   Int?              @map("collab_version")
  collabRevision  Int?              @map("collab_revision")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sourceFile      Document?         @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  mentions        TaskPageMention[]

  @@unique([userId, externalSource, externalId])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@index([sourceFileId])
  @@index([userId, parentId])
  @@index([userId, boardId, boardColumnId, boardOrder])
  @@map("task_pages")
}

model PageBoard {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  title       String
  description String     @default("")
  columns     Json
  tiles       Json       @default("[\"count\",\"distribution\"]")
  revision    Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  pages       TaskPage[]

  @@index([userId, createdAt])
  @@map("page_boards")
}

/// No entity foreign key: deleting an entity must leave its saved mention.
model TaskPageMention {
  id       String   @id @default(uuid())
  pageId   String   @map("page_id")
  kind     String
  entityId String   @map("entity_id")
  label    String
  page     TaskPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, kind, entityId])
  @@index([kind, entityId])
  @@map("task_page_mentions")
}

model PageDiscussion {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  taskId             String?          @map("task_id")
  projectId          String?          @map("project_id")
  deliverableId      String?          @map("deliverable_id")
  pageKind           String           @map("page_kind")
  pageId             String           @map("page_id")
  sourceKind         String           @map("source_kind")
  sourceId           String           @map("source_id")
  kind               String
  anchor             Json?
  body               Json
  mentions           Json             @default("[]")
  version            Int              @default(1)
  status             String           @default("open")
  resolved           Boolean          @default(false)
  answer             String?
  error              String?
  toolCalls          Json             @default("[]") @map("tool_calls")
  conversationId     String?          @map("conversation_id")
  assistantMessageId String?          @map("assistant_message_id")
  requestId          String?          @map("request_id")
  leaseAt            DateTime?        @map("lease_at")
  parentId           String?          @map("parent_id")
  /// "human" or "ensemble". A child row may only be ensemble.
  authorKind         String           @default("human") @map("author_kind")
  /// The person who wrote a human comment, in a shared space. Null: the space owner.
  authorAccountId    String?          @map("author_account_id")
  markId             String?          @map("mark_id")
  quote              String           @default("")
  deletedAt          DateTime?        @map("deleted_at")
  model              String?
  tier               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  task               Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable        Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  parent             PageDiscussion?  @relation("DiscussionChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children           PageDiscussion[] @relation("DiscussionChildren")

  @@index([userId, pageKind, pageId, sourceKind, sourceId], map: "page_discussions_scope_idx")
  @@index([parentId])
  @@index([userId, deletedAt])
  @@map("page_discussions")
}

model PlanStep {
  id        String     @id @default(uuid())
  taskId    String     @map("task_id")
  index     Int
  title     String
  status    StepStatus @default(pending)
  notes     String?
  toolCalls Json       @default("[]") @map("tool_calls")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, index])
  @@map("plan_steps")
}

model Run {
  feedback               Json            @default("[]")
  id                     String          @id @default(uuid())
  taskId                 String          @map("task_id")
  userId                 String          @map("user_id")
  worker                 String
  skillIds               String[]        @default([]) @map("skill_ids")
  /// Immutable signatures of the exact instructions used, never archived bodies.
  skillSignatures        Json            @default("[]") @map("skill_signatures")
  contextPackId          String?         @map("context_pack_id")
  promptVersion          String?         @map("prompt_version")
  assignmentInstructions String?         @map("assignment_instructions")
  /// Index of the next step. Persisted after every step so a restart resumes.
  cursor                 Int             @default(0)
  waitingApprovalId      String?         @map("waiting_approval_id")
  /// Exact continuation captured at an approval gate; never re-plan an approved write.
  checkpoint             Json?
  question               Json?
  traceId                String?         @map("trace_id")
  complexity             TaskComplexity?
  requestedModel         String?         @map("requested_model")
  plannerModel           String?         @map("planner_model")
  plannerCredits         Float           @default(0) @map("planner_credits")
  startedAt              DateTime        @default(now()) @map("started_at")
  endedAt                DateTime?       @map("ended_at")
  outcome                RunOutcome?
  error                  String?
  deletedAt              DateTime?       @map("deleted_at")
  /// The finished piece of work, as Markdown — not the step log.
  result                 String?
  task                   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  steps                  RunStep[]
  approvals              Approval[]
  contextPack            ContextPack?    @relation(fields: [contextPackId], references: [id], onDelete: SetNull)
  workspaceJob           WorkspaceJob?

  @@index([userId, startedAt])
  @@index([taskId])
  @@map("runs")
}

/// Append-only: the board history tab reads straight from this.
model TaskTransition {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  taskId     String      @map("task_id")
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  fromOwner  TaskOwner?  @map("from_owner")
  toOwner    TaskOwner?  @map("to_owner")
  actor      Actor
  reason     String?
  runId      String?     @map("run_id")
  at         DateTime    @default(now())
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([taskId, at])
  @@map("task_transitions")
}

model WorkspaceSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  taskId        String    @map("task_id")
  repoFullName  String?   @map("repo_full_name")
  repoPath      String?   @map("repo_path")
  branch        String?
  contextJson   Json      @default("{}") @map("context_json")
  contextPackId String?   @map("context_pack_id")
  handoffNote   String?   @map("handoff_note")
  status        String    @default("open")
  createdAt     DateTime  @default(now()) @map("created_at")
  closedAt      DateTime? @map("closed_at")
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("workspace_sessions")
}

model WorkspaceJob {
  id                   String              @id @default(uuid())
  sequence             BigInt              @default(autoincrement())
  userId               String              @map("user_id")
  /// The account whose computer and keys run this job, in a space more than one person can open.
  /// Null: the space owner. Only this account may answer its Needs me requests.
  runnerAccountId      String?             @map("runner_account_id")
  taskId               String              @map("task_id")
  runId                String?             @unique @map("run_id")
  /// "research" works without a computer; "code" works in a folder on this machine.
  kind                 String              @default("code")
  status               WorkspaceJobStatus  @default(queued)
  phase                String              @default("execute")
  executionMode        String              @map("execution_mode")
  /// Git ceiling, enforced on every git call: local | commit | push.
  delivery             String              @default("local")
  /// Ask on Needs me before each commit or push the ceiling allows.
  askBeforePublish     Boolean             @default(true) @map("ask_before_publish")
  /// The app may use the person's git sign-in for clone and push. The agent never sees the token.
  useCredentials       Boolean             @default(false) @map("use_credentials")
  markDone             Boolean             @default(true) @map("mark_done")
  unattended           Boolean             @default(false)
  /// review: read-only, no network, prompt only for more access. read-write: the usual grant.
  accessMode           String              @default("read-write") @map("access_mode")
  networkAccess        Boolean             @default(true) @map("network_access")
  /// Folder outside the workspace root the engineer granted; replaces the root for this job only.
  externalRoot         String?             @map("external_root")
  includePreRunChanges Boolean             @default(false) @map("include_pre_run_changes")
  createBranch         Boolean             @default(false) @map("create_branch")
  /// as-is | existing | new
  branchMode           String              @default("as-is") @map("branch_mode")
  continueFromJobId    String?             @map("continue_from_job_id")
  repoUrl              String?             @map("repo_url")
  provider             String?
  model                String
  reasoningEffort      String?             @map("reasoning_effort")
  instructions         String              @default("")
  repoPath             String              @default("") @map("repo_path")
  branch               String              @default("")
  baseBranch           String              @default("") @map("base_branch")
  sourceBranch         String?             @map("source_branch")
  maxToolCalls         Int                 @default(80) @map("max_tool_calls")
  turns                Int                 @default(0)
  toolCalls            Int                 @default(0) @map("tool_calls")
  tokensIn             Int                 @default(0) @map("tokens_in")
  tokensOut            Int                 @default(0) @map("tokens_out")
  /// One line: what the job is doing right now.
  progress             String?
  summary              String?
  resourceKeys         String[]            @default([]) @map("resource_keys")
  repository           Json                @default("{}")
  maxTurns             Int                 @default(40) @map("max_turns")
  maxMinutes           Int                 @default(60) @map("max_minutes")
  completeDeliverable  Boolean             @default(false) @map("complete_deliverable")
  context              Json?
  evidence             Json?
  publishRequest       Json?               @map("publish_request")
  activeProcess        Json?               @map("active_process")
  /// The pid for a server job; the device id for a device job.
  leaseOwner           String?             @map("lease_owner")
  leaseUntil           DateTime?           @map("lease_until")
  cancelRequestedAt    DateTime?           @map("cancel_requested_at")
  /// Null runs on this server. Set: only that paired device may claim it (docs/25 §4).
  deviceId             String?             @map("device_id")
  /// Returned by a device claim. Required on progress, ask, and complete.
  leaseToken           String?             @map("lease_token")
  claimedAt            DateTime?           @map("claimed_at")
  lastProgressAt       DateTime?           @map("last_progress_at")
  attempt              Int                 @default(0)
  /// Folder label the device published. A device job never carries a path.
  folderLabel          String?             @map("folder_label")
  /// What a device reported on complete: [{ kind: pr | commit | branch, url, sha? }].
  results              Json?
  /// The worker's structured result (node/report.ts StepReport), from the run's report_result tool or
  /// its .ensemble/result.json. Null: the worker reported nothing; the summary is prose only.
  report               Json?
  /// Idempotency for a job started by an outbox effect (node/outbox.ts): a redelivered effect finds this job.
  operationId          String?             @unique @map("operation_id")
  /// Order among the queued messages of an agent session, separate from continueFromJobId (which stays
  /// the true resume ancestry and is set when the job is claimed). Null: creation order.
  queuePosition        Int?                @map("queue_position")
  /// What the engine reported it ran with: { model, effort, context, contextTokens, fast }
  /// (workspace/engines/observed.ts), from the computer's progress and complete. Null: nothing reported yet.
  observedSettings     Json?               @map("observed_settings")
  error                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  startedAt            DateTime?           @map("started_at")
  finishedAt           DateTime?           @map("finished_at")
  task                 Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                  Run?                @relation(fields: [runId], references: [id], onDelete: SetNull)
  device               Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  events               WorkspaceEvent[]
  logChunks            WorkspaceLogChunk[]
  files                JobFile[]
  review               CodeReview?
  evidenceFiles        JobEvidence[]

  @@index([status, sequence])
  @@index([userId, taskId, createdAt])
  @@index([deviceId, status, sequence])
  @@index([runnerAccountId])
  @@map("workspace_jobs")
}

/// A computer the person paired for remote tasks (docs/25 §4.2). It signs in with its own `device` token.
model Device {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  /// Shown in the picker, for example "Office Mac".
  name         String
  /// macos | linux | windows
  platform     String
  appVersion   String?        @map("app_version")
  tokenId      String         @unique @map("token_id")
  /// Sandbox strength, max concurrent jobs, folder labels. Never paths to secrets.
  capabilities Json           @default("{}")
  /// The public key this computer reported first ({kid, alg, spki, fingerprint, pinnedAt}); the web encrypts secrets for it (credentials/device-key.ts).
  sealKey      Json?          @map("seal_key")
  lastSeenAt   DateTime?      @map("last_seen_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  revokedAt    DateTime?      @map("revoked_at")
  token        ApiToken       @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  jobs         WorkspaceJob[]

  @@index([userId, revokedAt])
  @@map("devices")
}

/// A one-time pairing code from Settings → Devices. Stored hashed; lasts 10 minutes.
model DevicePairing {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  deviceId  String?   @map("device_id")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("device_pairings")
}

/// Redacted run output a device uploaded, in batches. 64 KB per chunk, 2 MB per job.
/// Retention deletes chunks by `createdAt`; WorkspaceEvent stays the place for milestones.
/// The text of a file a device run changed, sent when the run ended (docs/25 §4.6). Kept 30 days; Ensemble on the web keeps none.
model JobFile {
  id        String       @id @default(uuid())
  jobId     String       @map("job_id")
  path      String
  /// added | modified | deleted
  status    String
  content   String?
  size      Int          @default(0)
  binary    Boolean      @default(false)
  truncated Boolean      @default(false)
  /// Why the text was not sent (a secrets file, too large, unreadable).
  skipped   String?
  createdAt DateTime     @default(now()) @map("created_at")
  job       WorkspaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, path])
  @@index([createdAt])
  @@map("job_files")
}

model WorkspaceLogChunk {
  id        String       @id @default(uuid())
  jobId     String       @map("job_id")
  seqFrom   Int          @map("seq_from")
  seqTo     Int          @map("seq_to")
  text      String
  bytes     Int
  createdAt DateTime     @default(now()) @map("created_at")
  job       WorkspaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seqFrom])
  @@index([createdAt])
  @@map("workspace_log_chunks")
}

model CodeReview {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  jobId          String               @unique @map("job_id")
  repoPath       String               @map("repo_path")
  initialHead    String               @map("initial_head")
  startTree      String               @map("start_tree")
  endTree        String               @map("end_tree")
  startCommit    String?              @map("start_commit")
  endCommit      String?              @map("end_commit")
  exactStart     Boolean              @default(true) @map("exact_start")
  agentPaths     String[]             @default([]) @map("agent_paths")
  attributed     Boolean              @default(false)
  ignoredChanged Json                 @default("[]") @map("ignored_changed")
  chunkTotal     Int?                 @map("chunk_total")
  expiresAt      DateTime             @map("expires_at")
  expiredAt      DateTime?            @map("expired_at")
  completedAt    DateTime?            @map("completed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  job            WorkspaceJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  decisions      CodeReviewDecision[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("code_reviews")
}

model CodeReviewDecision {
  reviewId String     @map("review_id")
  path     String
  chunkKey String     @map("chunk_key")
  decision String
  at       DateTime   @default(now())
  review   CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, path, chunkKey])
  @@map("code_review_decisions")
}

model TerminalPasskey {
  id         String    @id
  userId     String    @map("user_id")
  rpId       String    @map("rp_id")
  publicKey  Bytes     @map("public_key")
  counter    Int       @default(0)
  transports String[]  @default([])
  label      String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([userId])
  @@map("terminal_passkeys")
}

model TerminalSettings {
  userId       String   @id @map("user_id")
  enabled      Boolean  @default(true)
  allowTunnel  Boolean  @default(false) @map("allow_tunnel")
  roots        String[] @default([])
  trustedHooks Json     @default("{}") @map("trusted_hooks")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("terminal_settings")
}

model WorkspaceEvent {
  id        String       @id @default(uuid())
  sequence  BigInt       @default(autoincrement())
  jobId     String       @map("job_id")
  kind      String
  data      Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  job       WorkspaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, sequence])
  @@map("workspace_events")
}

model Notification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  kind          String
  title         String
  body          String    @default("")
  channel       String    @default("hub")
  taskId        String?   @map("task_id")
  url           String?
  urgent        Boolean   @default(false)
  readAt        DateTime? @map("read_at")
  deferredUntil DateTime? @map("deferred_until")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

model RunStep {
  id              String     @id @default(uuid())
  runId           String     @map("run_id")
  index           Int
  title           String
  status          StepStatus @default(pending)
  output          String?
  toolCalls       Json       @default("[]") @map("tool_calls")
  reasoning       String?
  reasoningSource String?    @map("reasoning_source")
  model           String?
  tokensIn        Int?       @map("tokens_in")
  tokensOut       Int?       @map("tokens_out")
  credits         Float?
  startedAt       DateTime?  @map("started_at")
  endedAt         DateTime?  @map("ended_at")
  error           String?
  run             Run        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([startedAt])
  @@map("run_steps")
}

model Approval {
  id            String            @id @default(uuid())
  runId         String            @map("run_id")
  taskId        String?           @map("task_id")
  userId        String            @map("user_id")
  kind          ApprovalKind
  title         String
  stepIndex     Int?              @map("step_index")
  preview       Json
  editedPayload Json?             @map("edited_payload")
  decision      ApprovalDecision?
  reason        String?
  requestedAt   DateTime          @default(now()) @map("requested_at")
  decidedAt     DateTime?         @map("decided_at")
  expiresAt     DateTime?         @map("expires_at")
  run           Run               @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepIndex])
  @@index([userId, decision, requestedAt])
  @@index([userId, decision])
  @@map("approvals")
}

// ── context — Engineer Graph + normalized artifacts ───────────────────────

model Person {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  upn                  String?
  name                 String
  email                String?
  role                 String?
  team                 String?
  relationshipWeight   Float            @default(0) @map("relationship_weight")
  typicalResponseHours Float?           @map("typical_response_hours")
  lastInteraction      DateTime?        @map("last_interaction")
  evidence             String[]         @default([])
  confidence           Float            @default(0.5)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")
  capacityHours        Float?           @map("capacity_hours")
  oneOnOneDays         Int?             @map("one_on_one_days")
  projects             ProjectPerson[]
  identities           PersonIdentity[] @relation("PersonIdentities")

  @@unique([userId, upn])
  @@index([userId, name])
  @@map("people")
}

/// One address or handle a person is known by (docs/03 §4.3). Ingest resolves a
/// person by any of these, email first. Two existing people are never merged here.
model PersonIdentity {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  personId          String   @map("person_id")
  /// email | slack | github | linear | jira | teams | zoom | phone | name
  kind              String
  /// Normalised: trimmed and lowercase.
  value             String
  /// Where it was seen first: gmail, slack, calendar, fireflies, merge, backfill…
  source            String   @default("ingest")
  verified          Boolean  @default(false)
  /// Ingest saw this identity together with another person's address. A merge suggestion until merged or dismissed.
  suggestedPersonId String?  @map("suggested_person_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person            Person   @relation("PersonIdentities", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, value])
  @@index([personId])
  @@map("person_identities")
}

model Project {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  name           String
  summary        String           @default("")
  notes          String           @default("")
  status         ProjectStatus    @default(active)
  aliases        String[]         @default([])
  workItemRoot   String?          @map("work_item_root")
  createdBy      Actor            @default(agent) @map("created_by")
  evidence       String[]         @default([])
  confidence     Float            @default(0.5)
  /// TipTap page body. Tasks keep their page on task_pages; this is the project page.
  content        Json?
  externalSource String?          @map("external_source")
  externalId     String?          @map("external_id")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  discussions    PageDiscussion[]
  tasks          Task[]
  artifacts      Artifact[]
  meetingNotes   MeetingNote[]
  meetingSessions MeetingSession[]
  people         ProjectPerson[]
  repoLinks      ProjectRepo[]
  deliverables   Deliverable[]
  sourceLinks    ProjectLink[]

  @@index([userId, name])
  @@unique([userId, externalSource, externalId])
  @@index([userId, status])
  @@index([userId, completedAt])
  @@map("projects")
}

/// "This channel is Project Atlas": a source container mapped to a project once,
/// applied at ingest to artifacts and proposed todos (docs/03 §4.4).
model ProjectLink {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  projectId     String   @map("project_id")
  /// slack | github | linear | jira | notion | trello | asana | google_drive | calendar | …
  source        String
  /// Slack channel id, GitHub owner/repo (lowercase), Linear team or project id, Jira project id, Notion database id, Trello board id, Drive folder id.
  containerId   String   @map("container_id")
  containerName String   @default("") @map("container_name")
  /// me | import
  createdBy     String   @default("me") @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, source, containerId])
  @@index([projectId])
  @@map("project_links")
}

model ProjectPerson {
  projectId String   @map("project_id")
  personId  String   @map("person_id")
  role      String?
  addedBy   Actor    @default(agent) @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([projectId, personId])
  @@index([personId])
  @@map("project_people")
}

model ProjectRepo {
  projectId String   @map("project_id")
  repoId    String   @map("repo_id")
  addedBy   Actor    @default(agent) @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo      Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@id([projectId, repoId])
  @@index([repoId])
  @@map("project_repos")
}

model Deliverable {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  projectId   String            @map("project_id")
  title       String
  status      DeliverableStatus @default(upcoming)
  due         DateTime?
  owner       String?
  notes       String            @default("")
  sourceRef   String?           @map("source_ref")
  createdBy   Actor             @default(agent) @map("created_by")
  completedAt DateTime?         @map("completed_at")
  pinned      Boolean           @default(false)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  discussions PageDiscussion[]

  @@index([userId, status, due])
  @@index([projectId, status])
  @@map("deliverables")
}

model Repo {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  fullName        String        @map("full_name")
  provider        RepoProvider  @default(github)
  url             String?
  description     String?
  defaultBranch   String?       @map("default_branch")
  tracked         Boolean       @default(false)
  lastSyncedAt    DateTime?     @map("last_synced_at")
  myRole          RepoRole      @default(contributor) @map("my_role")
  languages       String[]      @default([])
  prStats         Json          @default("{}") @map("pr_stats")
  codeownersPaths String[]      @default([]) @map("codeowners_paths")
  evidence        String[]      @default([])
  confidence      Float         @default(0.5)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  tasks           Task[]
  artifacts       Artifact[]
  meetingNotes    MeetingNote[]
  projects        ProjectRepo[]

  @@unique([userId, fullName])
  @@index([userId, tracked])
  @@map("repos")
}

model Preference {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  key        String
  value      Json
  evidence   String[]  @default([])
  confidence Float     @default(0.5)
  source     String    @default("agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([userId, key])
  @@map("preferences")
}

/// Deleting a person or project has to outlive the next sync.
model ContextSuppression {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  kind      String
  key       String
  label     String   @default("")
  reason    String   @default("deleted by the engineer")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, kind, key])
  @@index([userId, kind])
  @@map("context_suppressions")
}

model MeetingNote {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  title                String
  titleSource          String    @default("derived") @map("title_source")
  prompt               String    @default("")
  answer               String    @default("")
  model                String?
  tookSeconds          Float?    @map("took_seconds")
  askedAt              DateTime  @default(now()) @map("asked_at")
  occurredAt           DateTime? @map("occurred_at")
  personIds            String[]  @default([]) @map("person_ids")
  projectId            String?   @map("project_id")
  repoId               String?   @map("repo_id")
  comment              String?
  status               String    @default("ready")
  /// paste | connector | upload — not a vendor-specific paste path.
  source               String    @default("paste")
  error                String?
  extraction           Json?
  extractionModel      String?   @map("extraction_model")
  extractionCredits    Float?    @map("extraction_credits")
  extractedAt          DateTime? @map("extracted_at")
  appliedAt            DateTime? @map("applied_at")
  artifactId           String?   @map("artifact_id")
  /// The calendar event this meeting matched (connectors/meetings/match.ts). Null when no event matched or the match was ambiguous.
  eventArtifactId      String?   @map("event_artifact_id")
  /// The stored transcript (Artifact kind transcript) for imported meetings.
  transcriptArtifactId String?   @map("transcript_artifact_id")
  /// Meeting-notes connector (fireflies, fathom, granola, …) and its meeting id, so a re-sync updates in place.
  externalSource       String?   @map("external_source")
  externalId           String?   @map("external_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repo                 Repo?     @relation(fields: [repoId], references: [id], onDelete: SetNull)
  eventArtifact        Artifact? @relation("MeetingNoteEvent", fields: [eventArtifactId], references: [id], onDelete: SetNull)
  transcriptArtifact   Artifact? @relation("MeetingNoteTranscript", fields: [transcriptArtifactId], references: [id], onDelete: SetNull)
  tasks                Task[]

  @@unique([userId, externalSource, externalId])
  @@index([userId, askedAt])
  @@index([userId, extractedAt])
  @@index([userId, projectId])
  @@index([userId, status])
  @@index([eventArtifactId])
  @@map("meeting_notes")
}

/// Keyboard notes for one meeting. Soft-deleted into Trash.
/// Attaching notes updates the calendar artifact inside Ensemble only.
model MeetingSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  artifactId    String?   @map("artifact_id")
  meetingNoteId String?   @map("meeting_note_id")
  title         String
  /// Markdown mirror of `content`, for search, recaps, the assistant and exports.
  notes         String    @default("")
  /// The notes as a page document (the block editor). Null on notes saved before 13 Oct 2026.
  content       Json?
  recap         String    @default("")
  /// live | ended
  status        String    @default("live")
  /// none | pending | attached | declined
  attachState   String    @default("none") @map("attach_state")
  personIds     String[]  @default([]) @map("person_ids")
  projectId     String?   @map("project_id")
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  recapAt       DateTime? @map("recap_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([userId, artifactId])
  @@index([userId, startedAt])
  @@index([userId, projectId])
  @@map("meeting_sessions")
}

model Artifact {
  id                       String                   @id @default(uuid())
  userId                   String                   @map("user_id")
  taskId                   String?                  @map("task_id")
  kind                     ArtifactKind
  externalId               String                   @map("external_id")
  url                      String?
  ts                       DateTime
  actorId                  String?                  @map("actor_id")
  participants             Json                     @default("[]")
  title                    String                   @default("")
  text                     String                   @default("")
  threadId                 String?                  @map("thread_id")
  parentId                 String?                  @map("parent_id")
  projectId                String?                  @map("project_id")
  repoId                   String?                  @map("repo_id")
  metadata                 Json                     @default("{}")
  authoredByMe             Boolean                  @default(false) @map("authored_by_me")
  searchVector             Unsupported("tsvector")? @map("search_vector")
  createdAt                DateTime                 @default(now()) @map("created_at")
  deletedAt                DateTime?                @map("deleted_at")
  task                     Task?                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project                  Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repo                     Repo?                    @relation(fields: [repoId], references: [id], onDelete: SetNull)
  chunks                   ArtifactChunk[]
  extractions              Extraction[]
  document                 Document?
  meetingNotesAsEvent      MeetingNote[]            @relation("MeetingNoteEvent")
  meetingNotesAsTranscript MeetingNote[]            @relation("MeetingNoteTranscript")

  @@unique([userId, kind, externalId])
  @@index([userId, taskId])
  @@index([userId, ts])
  @@index([userId, threadId])
  @@index([userId, authoredByMe, kind])
  @@index([userId, kind, ts])
  @@index([userId, projectId])
  @@map("artifacts")
}

model Document {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  artifactId         String?   @unique @map("artifact_id")
  filename           String
  mediaType          String    @map("media_type")
  byteSize           Int       @map("byte_size")
  sha256             String
  /// The bytes, unless they are in blob storage (blobKey); one of the two is always set.
  original           Bytes?
  /// Key in the ENSEMBLE_FILE_STORAGE blob container (files/originals.ts).
  blobKey            String?   @map("blob_key")
  format             String
  parseStatus        String    @default("queued") @map("parse_status")
  parseError         Json?     @map("parse_error")
  parserVersion      String?   @map("parser_version")
  textCharacters     Int       @default(0) @map("text_characters")
  pageCount          Int?      @map("page_count")
  warnings           String[]  @default([])
  parsedAt           DateTime? @map("parsed_at")
  enrichmentStatus   String    @default("queued") @map("enrichment_status")
  enrichmentError    Json?     @map("enrichment_error")
  summary            String?
  enrichedAt         DateTime? @map("enriched_at")
  manualTags         Json      @default("{}") @map("manual_tags")
  matchedTags        Json      @default("{}") @map("matched_tags")
  projectIds         String[]  @default([]) @map("project_ids")
  repoIds            String[]  @default([]) @map("repo_ids")
  personIds          String[]  @default([]) @map("person_ids")
  taskIds            String[]  @default([]) @map("task_ids")
  workItemIds        String[]  @default([]) @map("work_item_ids")
  deliverableIds     String[]  @default([]) @map("deliverable_ids")
  generation         Int       @default(1)
  parseAttempts      Int       @default(0) @map("parse_attempts")
  enrichmentAttempts Int       @default(0) @map("enrichment_attempts")
  leaseToken         String?   @map("lease_token")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  modelUsage         Json      @default("[]") @map("model_usage")
  /// FileStyleProfile read from a PDF or Word original when it became a page.
  style              Json?
  /// { app, label, url?, externalId? } when the file came from a connected app.
  source             Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  artifact           Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  pages              TaskPage[]

  @@index([userId, createdAt, id])
  @@index([parseStatus, enrichmentStatus, createdAt])
  @@index([leaseExpiresAt])
  @@index([projectIds], type: Gin)
  @@index([repoIds], type: Gin)
  @@index([personIds], type: Gin)
  @@index([taskIds], type: Gin)
  @@index([workItemIds], type: Gin)
  @@index([deliverableIds], type: Gin)
  @@index([blobKey])
  @@map("context_documents")
}

model Extraction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  artifactId  String   @unique @map("artifact_id")
  items       Json     @default("[]")
  model       String?
  method      String   @default("heuristic")
  extractedAt DateTime @default(now()) @map("extracted_at")
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([userId, extractedAt])
  @@map("extractions")
}

model SyncState {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  connector  String
  cursor     String?
  lastSyncAt DateTime? @map("last_sync_at")
  lastError  String?   @map("last_error")
  itemCount  Int       @default(0) @map("item_count")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([userId, connector])
  @@map("sync_state")
}

model ArtifactChunk {
  id         String                       @id @default(uuid())
  artifactId String                       @map("artifact_id")
  index      Int                          @default(0)
  text       String
  embedding  Unsupported("vector(3072)")?
  createdAt  DateTime                     @default(now()) @map("created_at")
  artifact   Artifact                     @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, index])
  @@map("artifact_chunks")
}

model ContextPack {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  taskId          String?  @map("task_id")
  summary         String
  items           Json     @default("[]")
  skillsSuggested String[] @default([]) @map("skills_suggested")
  tokenEstimate   Int?     @map("token_estimate")
  builtAt         DateTime @default(now()) @map("built_at")
  runs            Run[]

  @@index([userId, builtAt])
  @@map("context_packs")
}

// ── skills ────────────────────────────────────────────────────────────────

model Skill {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  slug            String
  name            String
  description     String          @default("")
  scope           Json            @default("{}")
  version         Int             @default(1)
  body            String
  evidence        String[]        @default([])
  confidence      Float           @default(0.5)
  enabled         Boolean         @default(true)
  provenance      SkillProvenance @default(bootstrap)
  styleProfile    Json            @default("{}") @map("style_profile")
  minedFrom       Int             @default(0) @map("mined_from")
  acceptanceRate  Float?          @map("acceptance_rate")
  acceptedCount   Int             @default(0) @map("accepted_count")
  editedCount     Int             @default(0) @map("edited_count")
  rejectedCount   Int             @default(0) @map("rejected_count")
  lastUsedAt      DateTime?       @map("last_used_at")
  proposedBody    String?         @map("proposed_body")
  proposedChanges Json?           @map("proposed_changes")
  proposedAt      DateTime?       @map("proposed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  versions        SkillVersion[]
  feedback        SkillFeedback[]

  @@unique([userId, slug])
  @@index([userId, enabled])
  @@map("skills")
}

model SkillFeedback {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  skillId    String   @map("skill_id")
  kind       String
  runId      String?  @map("run_id")
  approvalId String?  @map("approval_id")
  original   Json?
  edited     Json?
  reason     String?
  folded     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@map("skill_feedback")
}

model SkillVersion {
  id        String   @id @default(uuid())
  skillId   String   @map("skill_id")
  version   Int
  body      String
  evidence  String[] @default([])
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@map("skill_versions")
}

// ── audit / metrics ───────────────────────────────────────────────────────

model AuditLedger {
  id         String   @id @default(uuid())
  ts         DateTime @default(now())
  userId     String   @map("user_id")
  actor      Actor
  action     String
  taskId     String?  @map("task_id")
  runId      String?  @map("run_id")
  approvalId String?  @map("approval_id")
  inputHash  String?  @map("input_hash")
  outputHash String?  @map("output_hash")
  prevHash   String?  @map("prev_hash")
  hash       String
  payload    Json     @default("{}")

  @@index([userId, ts])
  @@index([runId])
  @@map("audit_ledger")
}

model MetricEvent {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  ts      DateTime @default(now())
  kind    String
  taskId  String?  @map("task_id")
  runId   String?  @map("run_id")
  seconds Float?
  payload Json     @default("{}")

  @@index([userId, kind, ts])
  @@map("metric_events")
}

/// One included-model call against an account's monthly Ensemble credits (src/included/budget.ts).
/// A row is written as `reserved` before the call and settled with the real usage after it.
model IncludedUsage {
  id                   String    @id @default(uuid())
  /// The account that pays: a space resolves to its owner.
  accountId            String    @map("account_id")
  creditKey            String?   @map("credit_key")
  erasedAt             DateTime? @map("erased_at")
  /// The space or account the call ran for.
  userId               String    @map("user_id")
  /// UTC calendar month, "2026-10".
  period               String
  model                String
  answeredBy           String?   @map("answered_by")
  purpose              String?
  /// reserved, settled, unreported (the call stopped without usage), expired (never settled).
  status               String    @default("reserved")
  estimatedInputTokens Int       @map("estimated_input_tokens")
  maxOutputTokens      Int       @map("max_output_tokens")
  reservedUsd          Decimal   @map("reserved_usd") @db.Decimal(20, 10)
  usd                  Decimal   @default(0) @db.Decimal(20, 10)
  inputUsd             Decimal   @default(0) @map("input_usd") @db.Decimal(20, 10)
  outputUsd            Decimal   @default(0) @map("output_usd") @db.Decimal(20, 10)
  inputTokens          Int       @default(0) @map("input_tokens")
  cacheReadTokens      Int       @default(0) @map("cache_read_tokens")
  cacheWriteTokens     Int       @default(0) @map("cache_write_tokens")
  outputTokens         Int       @default(0) @map("output_tokens")
  createdAt            DateTime  @default(now()) @map("created_at")
  settledAt            DateTime? @map("settled_at")
  account              User      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, period])
  @@index([status, createdAt])
  @@map("included_usage")
}

/// Monthly allowance enforcement, independent of erasable workspace/call history.
/// The key is a purpose-separated HMAC of the account email, never the address itself.
model IncludedCreditBalance {
  creditKey String  @map("credit_key")
  period    String
  usedUsd   Decimal @default(0) @map("used_usd") @db.Decimal(20, 10)

  @@id([creditKey, period])
  @@index([period])
  @@map("included_credit_balances")
}

/// The operator's spend across every account for one month. Its row is the lock every reservation
/// takes, and it keeps counting after an account and its usage rows are deleted.
model IncludedPeriod {
  period      String   @id
  spentUsd    Decimal  @default(0) @map("spent_usd") @db.Decimal(20, 10)
  reservedUsd Decimal  @default(0) @map("reserved_usd") @db.Decimal(20, 10)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("included_periods")
}

model MetricBaseline {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  kind       String
  seconds    Float
  sampleSize Int      @default(0) @map("sample_size")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, kind])
  @@map("metric_baselines")
}

model AuthToken {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     String
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  scopes       String[] @default([])
  account      String?
  /// Non-secret connection details, e.g. { cloudId, site } for Atlassian or { baseUri, accountId } for DocuSign.
  meta         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("oauth_tokens")
}

model AssistantConversation {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  /// Who is chatting, in a shared space. Null: the space owner. Conversations are private to this person.
  accountId String?            @map("account_id")
  title     String             @default("New chat")
  startedOn String?            @map("started_on")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                @id @default(uuid())
  conversationId String                @map("conversation_id")
  userId         String                @map("user_id")
  role           String
  content        String                @default("")
  toolCalls      Json                  @default("[]") @map("tool_calls")
  /// On the person's own messages: the mentions it named, `[{ kind, id, label }]`, so the dock shows exact chips after a reload.
  /// On replies: the records the reply names by id (`AssistantRef`), so it shows their titles (docs/11 §4.1).
  mentions       Json                  @default("[]") @map("mentions")
  model          String?
  credentialSource String? @map("credential_source")
  credits        Float?
  createdAt      DateTime              @default(now()) @map("created_at")
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
  @@map("assistant_messages")
}

model AssistantWorkflow {
  id             String   @id
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  planHash       String   @map("plan_hash")
  steps          Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, conversationId])
  @@map("assistant_workflows")
}

model UndoEntry {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  seq            BigInt
  label          String
  kind           String
  actor          Actor     @default(me)
  subject        String
  href           String?
  inverse        Json
  forward        Json
  ops            Json      @default("[]")
  source         String    @default("ui")
  groupId        String?   @map("group_id")
  undoneAt       DateTime? @map("undone_at")
  /// Who made the change, in a shared space. Null: the space owner. Each person undoes only their own changes.
  actorAccountId String?   @map("actor_account_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([userId, seq])
  @@index([userId, undoneAt, seq])
  @@map("undo_entries")
}

/// Private local reminders. Never mirrored to artifacts or retrieval.
model Reminder {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  title                String
  titleContent         Json      @map("title_content")
  dueDate              String    @map("due_date")
  dueTime              String?   @map("due_time")
  timeZone             String    @map("time_zone")
  revision             Int       @default(0)
  nextNotificationAt   DateTime? @map("next_notification_at")
  lastNotifiedAt       DateTime? @map("last_notified_at")
  notificationSequence Int       @default(0) @map("notification_sequence")
  actionTokenHash      String    @map("action_token_hash")
  claimToken           String?   @map("claim_token")
  claimUntil           DateTime? @map("claim_until")
  deliveryError        String?   @map("delivery_error")
  dismissedAt          DateTime? @map("dismissed_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([userId, deletedAt, dismissedAt, nextNotificationAt], map: "private_reminders_due_idx")
  @@map("private_reminders")
}

/// Compact snapshot written before a completed task or deliverable is purged.
/// The future skill miner reads this table; the source row may already be gone.
model CompletionRecord {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  entityKind   String    @map("entity_kind")
  entityId     String    @map("entity_id")
  title        String
  summary      String    @default("")
  skillIds     String[]  @default([]) @map("skill_ids")
  people       String[]  @default([])
  projectId    String?   @map("project_id")
  projectName  String?   @map("project_name")
  repoId       String?   @map("repo_id")
  repoFullName String?   @map("repo_full_name")
  outcome      String
  completedAt  DateTime? @map("completed_at")
  sourceJson   Json      @default("{}") @map("source_json")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("completion_records")
}

/// Cached probe of a model id against the user's key. Not a secret.
model ModelProbe {
  userId    String   @map("user_id")
  provider  String
  model     String
  kind      String
  detail    String   @default("")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@id([userId, provider, model])
  @@map("model_probes")
}

/// The models a key reaches, as its provider listed them, kept for a week (lib/model-catalog.ts).
model ModelCatalog {
  userId    String   @map("user_id")
  provider  String
  /// The runtime's catalog entry: models, cheapest, chat, error, and per model what the provider said about it (`meta`, its thinking levels).
  entry     Json
  /// The key's hint when the list was fetched; a different key fetches again.
  keyHint   String   @default("") @map("key_hint")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@id([userId, provider])
  @@map("model_catalogs")
}

/// A condition the scheduler evaluates. Creating one is a proposal; firing writes a notification.
model Watcher {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  surface     String    @default("deliverable")
  prompt      String    @default("")
  scopeKind   String    @map("scope_kind")
  scopeId     String    @map("scope_id")
  condition   String
  daysBefore  Int?      @map("days_before")
  action      String    @default("notify")
  message     String    @default("")
  status      String    @default("active")
  firedAt     DateTime? @map("fired_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("watchers")
}

/// An in-place @ensemble answer, kept so a refresh does not lose the thread.
model EnsembleReply {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  surface   String
  anchorKey String   @map("anchor_key")
  prompt    String
  content   String   @default("")
  toolCalls Json     @default("[]") @map("tool_calls")
  citations Json     @default("[]")
  actAs     String   @default("general") @map("act_as")
  model     String   @default("")
  tier      String   @default("medium")
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, surface, anchorKey])
  @@map("ensemble_replies")
}

model ReminderDesktopBinding {
  hostId    String   @id @map("host_id")
  userId    String   @map("user_id")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("private_reminder_desktops")
}

// ── accounts, sessions, credentials ───────────────────────────────────────

/// The first account created on an instance adopts ENSEMBLE_DEV_USER_ID so data
/// made before sign-in existed stays with its owner.
model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String                @default("")
  passwordHash          String?               @map("password_hash")
  emailVerifiedAt       DateTime?             @map("email_verified_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  lastLoginAt           DateTime?             @map("last_login_at")
  /// student | teacher | lawyer | engineer | vibe. Not an ActAs value.
  onboardingRole        String?               @map("onboarding_role")
  onboardingTemplateId  String?               @map("onboarding_template_id")
  /// Null until the role wizard finishes. Existing accounts are stamped by migration.
  onboardingCompletedAt DateTime?             @map("onboarding_completed_at")
  gender                String?
  profession            String?
  organization          String?
  heardFrom             String?               @map("heard_from")
  profileCompletedAt    DateTime?             @map("profile_completed_at")
  /// Optional modules that are on. Sorted ids. Empty means none of them.
  moduleSet             String                @default("code,diagrams,metrics,runs,skills,workspace") @map("module_set")
  /// Tester accounts may open the marketplace and switch desks. Everyone else keeps the signup role.
  tester                Boolean               @default(false)
  activeTemplateId      String?               @map("active_template_id")
  appliedVersion        Int                   @default(0) @map("applied_version")
  chromeLabels          Json                  @default("{}") @map("chrome_labels")
  templateExpiresAt     DateTime?             @map("template_expires_at")
  /// Layouts from before the first marketplace apply. Default restores these.
  layoutBaseline        Json?                 @map("layout_baseline")
  /// Set on an Ensemble space: the account that owns it. Null on the account itself.
  /// A space is never signed in to directly; the account switches into it.
  ownerId               String?               @map("owner_id")
  owner                 User?                 @relation("Spaces", fields: [ownerId], references: [id], onDelete: Cascade)
  spaces                User[]                @relation("Spaces")
  /// The space's label in the switcher. On the account it names the first space.
  spaceName             String?               @map("space_name")
  /// One emoji, or null for the initial.
  spaceIcon             String?               @map("space_icon")
  spacePosition         Int                   @default(0) @map("space_position")
  /// Account only. Settings, model keys and shortcuts are mirrored to every space.
  spaceSettingsSync     Boolean               @default(false) @map("space_settings_sync")
  /// Account only. The space a new sign-in opens.
  lastSpaceId           String?               @map("last_space_id")
  contacts              Contact[]             @relation("ContactOwner")
  contactOf             Contact[]             @relation("ContactPerson")
  members               SpaceMember[]         @relation("SpaceMembers")
  memberships           SpaceMember[]         @relation("MemberAccount")
  sharesOut             Share[]               @relation("ShareSpace")
  sharesIn              Share[]               @relation("ShareRecipient")
  transfers             SpaceTransfer[]
  publicLinks           PublicLink[]          @relation("PublicLinkSpace")
  publicLinksMade       PublicLink[]          @relation("PublicLinkCreator")
  /// A picture avatar, `role.gender.n` (packages/shared-types/src/avatars.ts). Null: initials.
  avatar                String?
  sessions              Session[]
  interactionEvents     InteractionEvent[]
  authIdentities        AuthIdentity[]
  emailTokens           EmailToken[]
  authFlows             AuthFlow[]
  cliAuthRequests       CliAuthRequest[]
  importJobs            ImportJob[]
  mcpConnections        McpConnection[]
  personIdentities      PersonIdentity[]
  projectLinks          ProjectLink[]
  apiTokens             ApiToken[]
  devicePairings        DevicePairing[]
  diagrams              BlockDiagram[]
  diagramLinks          DiagramLink[]
  plotDatasets          PlotDataset[]
  plots                 Plot[]
  widgetLayouts         WidgetLayout[]
  templateApplications  TemplateApplication[]
  includedUsage         IncludedUsage[]

  @@index([ownerId])
  @@map("users")
}

model AuthIdentity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

/// Verification and password-reset secrets are stored only as SHA-256 hashes.
model EmailToken {
  id        String   @id
  userId    String   @map("user_id")
  kind      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
  @@map("email_tokens")
}

/// Short-lived, single-use OAuth state, bound to the initiating browser.
model AuthFlow {
  id           String   @id
  provider     String
  codeVerifier String   @map("code_verifier")
  nonce        String
  userId       String?  @map("user_id")
  sessionId    String?  @map("session_id")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_flows")
}

/// RFC 8628-style login requests for the CLI. Device and user codes are stored hashed.
model CliAuthRequest {
  id              String    @id @default(uuid())
  deviceCodeHash  String    @unique @map("device_code_hash")
  userCodeHash    String    @unique @map("user_code_hash")
  clientName      String    @map("client_name")
  platform        String
  version         String
  requestIp       String?   @map("request_ip")
  requestedScopes String[]  @default([]) @map("requested_scopes")
  approvedScopes  String[]  @default([]) @map("approved_scopes")
  status          String    @default("pending")
  userId          String?   @map("user_id")
  tokenId         String?   @map("token_id")
  pairingId       String?   @map("pairing_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  lastPolledAt    DateTime? @map("last_polled_at")
  decidedAt       DateTime? @map("decided_at")
  consumedAt      DateTime? @map("consumed_at")
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@map("cli_auth_requests")
}

/// A person's block diagram. `document` is the versioned JSON model (maps keyed by id).
/// `version` is the per-save revision, ready for optimistic concurrency and later collaboration.
model BlockDiagram {
  id        String                 @id @default(uuid())
  userId    String                 @map("user_id")
  title     String                 @default("Untitled diagram")
  source    String                 @default("")
  document  Json                   @default("{}")
  version   Int                    @default(1)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  deletedAt DateTime?              @map("deleted_at")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     DiagramLink[]
  revisions BlockDiagramRevision[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("block_diagrams")
}

/// A saved copy of a diagram at one version, so a person can restore it.
model BlockDiagramRevision {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  diagramId String       @map("diagram_id")
  version   Int
  title     String
  source    String
  document  Json
  createdAt DateTime     @default(now()) @map("created_at")
  diagram   BlockDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@unique([diagramId, version])
  @@index([userId, diagramId])
  @@map("block_diagram_revisions")
}

/// A table the person imported. Bytes live on disk; this row never stores a path the client can see.
model PlotDataset {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  format      String
  columns     Json
  rowCount    Int       @map("row_count")
  byteSize    Int       @map("byte_size")
  contentHash String    @map("content_hash")
  sheet       String    @default("")
  sheets      Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plots       Plot[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("plot_datasets")
}

/// A saved chart: dataset, encoding, style, annotations, and an optional matplotlib script.
model Plot {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  title     String       @default("Untitled plot")
  datasetId String?      @map("dataset_id")
  config    Json         @default("{}")
  code      String       @default("")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset   PlotDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("plots")
}

/// A diagram shown on a page, task, deliverable, project, or repo.
model DiagramLink {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  diagramId  String       @map("diagram_id")
  targetKind String       @map("target_kind")
  targetId   String       @map("target_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagram    BlockDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@unique([diagramId, targetKind, targetId])
  @@index([userId, targetKind, targetId])
  @@map("diagram_links")
}

/// One layout per user per surface. Not settings, not trash, not the bridge.
model WidgetLayout {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  surface    String
  templateId String?  @map("template_id")
  document   Json
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surface])
  @@map("widget_layouts")
}

/// Chrome snapshots for marketplace apply and revert. Not task bodies, not the undo stack.
model TemplateApplication {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("template_applications")
}

/// Only the SHA-256 of the cookie value is stored.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  /// Copy of the user's module set. Rewritten when they switch a feature or apply a template.
  /// Null is fail-closed: no optional modules.
  modules   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Personal tokens. Shown once, stored hashed.
/// `full` can act as you (editor hooks). `bridge` can only read `/api/bridge`.
/// `device` can only call `/api/devices/self/*`, and only while its Device is not revoked.
/// Any other scope is rejected and grants nothing.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  scope      String    @default("full")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices    Device[]

  @@index([userId])
  @@map("api_tokens")
}

/// Written and read by agent-runtime only (docs/11 §5). Encrypted with the shared secret key.
model ModelCredential {
  userId    String   @map("user_id")
  provider  String
  secret    String
  hint      String   @default("")
  baseUrl   String?  @map("base_url")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([userId, provider])
  @@map("model_credentials")
}

/// Instance-level OAuth client for a connector (Google, GitHub). Set once by whoever
/// runs the instance; env vars win when present. clientSecret is encrypted.
model ConnectorApp {
  provider     String   @id
  clientId     String   @map("client_id")
  clientSecret String   @map("client_secret")
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("connector_apps")
}

// ── decision router: approvals asked by outside agents ────────────────────

/// A permission prompt from Cursor, Claude Code, VS Code Copilot, … routed to Needs me.
/// The hook that asked is blocked until status leaves pending or expiresAt passes.
/// A task Ensemble opened in an agent's own app or window (Claude, Codex, Cursor, VS Code) on
/// this computer. Prompts and questions from its sessions reach Needs me, and the person may
/// answer in either place (docs/30_ENGINES.md "In the agent's own app").
model AgentHandoff {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  taskId    String   @map("task_id")
  /// claude | codex | cursor | vscode
  app       String
  folder    String
  /// Written into the task's prompt; the agent's UserPromptSubmit hook links its session by it.
  marker    String   @unique
  /// The agent's own session ids seen with this hand-off.
  sessions  String[] @default([])
  /// open: the agent may still be working. finished: its last turn ended. closed: done with.
  status    String   @default("open")
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("agent_handoffs")
}

model AgentDecision {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  source      String
  event       String
  toolName    String    @map("tool_name")
  title       String
  detail      Json      @default("{}")
  sessionId   String?   @map("session_id")
  cwd         String?
  status      String    @default("pending")
  decision    String?
  scope       String?
  reason      String?
  requestedAt DateTime  @default(now()) @map("requested_at")
  decidedAt   DateTime? @map("decided_at")
  expiresAt   DateTime  @map("expires_at")

  @@index([userId, status, requestedAt])
  @@map("agent_decisions")
}

/// "Allow for this session" and "Always allow" answers, applied before a card is shown.
model DecisionRule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  source    String
  toolName  String   @map("tool_name")
  /// Exact shell command, or "*" for every call of toolName.
  pattern   String
  decision  String
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, source, toolName])
  @@map("decision_rules")
}

/// Recurring class slots for the Semester and Classes desks.
model TimetableSlot {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  title    String
  weekday  Int
  startMin Int    @map("start_min")
  endMin   Int    @map("end_min")
  course   String @default("")

  @@index([userId, weekday])
  @@map("timetable_slots")
}

model CourtHoliday {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  day    DateTime
  name   String

  @@index([userId, day])
  @@map("court_holidays")
}

model AttendanceMark {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  personId String   @map("person_id")
  day      DateTime
  present  Boolean  @default(true)

  @@index([userId, day])
  @@map("attendance_marks")
}

model Objective {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  title    String
  progress Int    @default(0)

  @@index([userId])
  @@map("objectives")
}

model DeployEvent {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  name   String
  env    String   @default("prod")
  at     DateTime @default(now())

  @@index([userId, at])
  @@map("deploy_events")
}

model PartRow {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String
  status String @default("out")
  qty    Int    @default(1)

  @@index([userId])
  @@map("part_rows")
}

model TestResult {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String
  build  String @default("")
  status String @default("unknown")

  @@index([userId])
  @@map("test_results")
}

model CitationLink {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  fromTitle String @map("from_title")
  toTitle   String @map("to_title")

  @@index([userId])
  @@map("citation_links")
}

model GradingRow {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  className String @map("class_name")
  expected  Int    @default(0)
  marked    Int    @default(0)

  @@index([userId])
  @@map("grading_rows")
}

/// One run of "Import from …". Counts and progress are written as it goes so the dialog can poll.
model ImportJob {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  /// notion | linear | jira | trello | asana | todoist | clickup | monday | github | csv
  source     String
  status     String    @default("queued")
  options    Json      @default("{}")
  /// { tasks: { created, updated, skipped }, pages: {...}, projects: {...} }
  counts     Json      @default("{}")
  progress   Json      @default("{}")
  error      String?
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("import_jobs")
}

/// A remote MCP server this person connected (Notion, Linear, Atlassian, Canva, or a custom URL).
/// Secrets (client secret, tokens, PKCE verifier) are encrypted with lib/secrets.
model McpConnection {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  /// Catalog id such as "notion", or "custom-<hash>" for a pasted URL.
  serverId       String    @map("server_id")
  name           String
  url            String
  /// pending | connected | error | disabled
  status         String    @default("pending")
  /// Dynamic client registration result or a configured client: { client_id, client_secret?, ... }, encrypted JSON.
  clientInfo     String?   @map("client_info")
  /// OAuth tokens as encrypted JSON: { access_token, refresh_token?, expires_in?, scope?, token_type }.
  tokens         String?
  expiresAt      DateTime? @map("expires_at")
  codeVerifier   String?   @map("code_verifier")
  oauthState     String?   @unique @map("oauth_state")
  stateExpiresAt DateTime? @map("state_expires_at")
  returnTo       String?   @map("return_to")
  /// Cached tools/list result: [{ name, title?, description, inputSchema, annotations? }].
  tools          Json      @default("[]")
  toolsSyncedAt  DateTime? @map("tools_synced_at")
  /// Tool names this person switched off.
  disabledTools  String[]  @default([]) @map("disabled_tools")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId])
  @@map("mcp_connections")
}

/// People an account shares with. At most five per account; removing one revokes everything shared with them.
model Contact {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  contactId String   @map("contact_id")
  createdAt DateTime @default(now()) @map("created_at")
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact   User     @relation("ContactPerson", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([contactId])
  @@map("contacts")
}

/// Another account that may open a whole space. role: viewer | editor. At most two per space.
model SpaceMember {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  accountId String   @map("account_id")
  role      String   @default("editor")
  addedBy   String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  space     User     @relation("SpaceMembers", fields: [spaceId], references: [id], onDelete: Cascade)
  account   User     @relation("MemberAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([spaceId, accountId])
  @@index([accountId])
  @@map("space_members")
}

/// One item in a space shared with one account. kind: page | task | board | diagram | plot_space | plot | meeting | skill | workspace | code. role: view | edit.
model Share {
  id          String    @id @default(uuid())
  spaceId     String    @map("space_id")
  kind        String
  resourceId  String    @map("resource_id")
  title       String    @default("")
  recipientId String    @map("recipient_id")
  role        String    @default("view")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  openedAt    DateTime? @map("opened_at")
  space       User      @relation("ShareSpace", fields: [spaceId], references: [id], onDelete: Cascade)
  recipient   User      @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([spaceId, kind, resourceId, recipientId])
  @@index([recipientId])
  @@map("shares")
}

/// A space's one change of owner.
model SpaceTransfer {
  id            String   @id @default(uuid())
  spaceId       String   @unique @map("space_id")
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  createdAt     DateTime @default(now()) @map("created_at")
  space         User     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("space_transfers")
}

/// One item anyone with the link can open, with no account (docs/29 §7).
model PublicLink {
  id         String    @id @default(uuid())
  token      String    @unique
  spaceId    String    @map("space_id")
  kind       String
  resourceId String    @map("resource_id")
  title      String    @default("")
  role       String    @default("view")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  openedAt   DateTime? @map("opened_at")
  opens      Int       @default(0)
  space      User      @relation("PublicLinkSpace", fields: [spaceId], references: [id], onDelete: Cascade)
  creator    User      @relation("PublicLinkCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([spaceId, kind, resourceId])
  @@index([createdBy])
  @@map("public_links")
}

// Minimal operational deletion log; no account content or foreign key survives erasure.
model AccountDeletionLog {
  emailKey  String   @id @map("email_key")
  deletedAt DateTime @default(now()) @map("deleted_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("account_deletion_logs")
}

model PageRevision {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  pageId          String   @map("page_id")
  revision        Int
  title           String
  content         Json?
  annotations     Json     @default("[]")
  authorAccountId String?  @map("author_account_id")
  createdAt       DateTime @default(now()) @map("created_at")
  page            TaskPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, pageId, createdAt])
  @@map("page_revisions")
}

model PageTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  profile   String
  title     String
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, profile, createdAt])
  @@map("page_templates")
}

/// What a person did in the Hub, for the operator's own analysis (docs/07 §1.3): which screen and for
/// how long it was actively in use, and named actions. Never content: no titles, text, file names or
/// ids from the page. Written by POST /api/telemetry; deleted with the account and after
/// ENSEMBLE_INTERACTION_RETENTION_DAYS (730 by default).
model InteractionEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id")
  /// Random per browser tab, so one visit's events read in order.
  sessionKey String   @map("session_key")
  at         DateTime
  receivedAt DateTime @default(now()) @map("received_at")
  /// view (a screen and its active time) | action (a named action) | session (tab opened)
  kind       String
  /// board, pages, meetings, plots, files, code, assistant, settings…
  surface    String
  /// The route with ids replaced, e.g. /pages/:id.
  route      String
  action     String?
  /// Active time on the screen, for kind=view.
  durationMs Int?     @map("duration_ms")
  /// Small, named, non-content details (counts, modes, sizes).
  props      Json     @default("{}")
  client     String   @default("web")
  viewport   String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
  @@index([surface, at])
  @@map("interaction_events")
}

/// Ensemble Node (docs/35): a persistent AI teammate owned by one account. Its turns are
/// assistant turns (assistant/agent.ts) with the node's charter and room, in its owner's space.
model NodeAgent {
  id           String           @id @default(uuid())
  /// The owning account. Node is account-level: it never follows the open space cookie.
  userId       String           @map("user_id")
  /// The space it reads and writes. Null: the account's own space.
  spaceId      String?          @map("space_id")
  /// Lowercase handle (@manager). Unique per account; never changes.
  slug         String
  name         String
  role         String           @default("assistant")
  /// `{ shape, color, eyes }`, drawn by the Node web app.
  avatar       Json             @default("{}")
  charter      String           @default("")
  /// Chat model. Null: the Node default (included gpt-5-mini).
  provider     String?
  model        String?
  /// Ensemble run profile for work on a computer. Null: the person's default profile.
  runProfileId String?          @map("run_profile_id")
  /// `{ sharedRooms: "ask" | "auto" }`: whether it posts in rooms with other people without asking.
  autonomy     Json             @default("{}")
  /// active | paused
  status       String           @default("active")
  templateId   String?          @map("template_id")
  /// A temporary helper (node/helpers.ts): the node it works for. It and its task room go when the room is idle.
  parentNodeId String?          @map("parent_node_id")
  /// Thinking level of its chat model: low | medium | high. Null: low.
  effort       String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  memberships  NodeRoomMember[]
  memories     NodeMemory[]
  turns        NodeTurn[]
  routines     NodeRoutine[]
  sessionEvents NodeSessionEvent[]

  @@unique([userId, slug])
  @@index([parentNodeId])
  @@map("node_agents")
}

/// A conversation: dm (a person and one node), crew (a person and their nodes) or room (people, each with their nodes).
model NodeRoom {
  id            String           @id @default(uuid())
  /// Who created it. Deleting that account deletes the room.
  userId        String           @map("user_id")
  /// dm | crew | group
  kind          String
  title         String
  /// `{ leadNodeIds, responsibilities: { accountId: text } }`
  settings      Json             @default("{}")
  /// Last message seq; incremented in the message insert's transaction.
  lastSeq       Int              @default(0) @map("last_seq")
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  archivedAt    DateTime?        @map("archived_at")
  members       NodeRoomMember[]
  messages      NodeMessage[]
  runs          NodeRun[]
  invites       NodeRoomInvite[]
  peerRequests  NodePeerRequest[]

  @@index([userId])
  @@map("node_rooms")
}

/// A person or a node in a room. `userId` is the account the membership belongs to (the node's owner for a node).
/// A request to join a room with other people (docs/35 §3). The invitee accepts with 1–3 of their
/// nodes or declines; a declined request blocks a new one to the same person in that room for 30 days.
/// At most one pending request per person and room (partial unique index in the migration).
model NodeRoomInvite {
  id          String    @id @default(uuid())
  roomId      String    @map("room_id")
  inviterId   String    @map("inviter_id")
  inviteeId   String    @map("invitee_id")
  /// pending | accepted | declined | cancelled
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")
  room        NodeRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, inviteeId])
  @@index([inviteeId, status])
  @@index([inviterId])
  @@map("node_room_invites")
}

model NodeRoomMember {
  id                    String     @id @default(uuid())
  roomId                String     @map("room_id")
  userId                String     @map("user_id")
  /// Set for a node member; null for a person.
  nodeId                String?    @map("node_id")
  /// Unique in the room: a person's handle, a node's slug, or owner/slug in group rooms.
  handle                String
  /// owner | member
  role                  String     @default("member")
  /// The node is its owner's front door in a room shared with other people.
  representative        Boolean    @default(false)
  /// The node's own assistant conversation for this room's shared thread (its memory of the room, tool calls, proposals).
  conversationId        String?    @map("conversation_id")
  /// The newest shared message seq this node has already read.
  seenSeq               Int        @default(0) @map("seen_seq")
  /// The node's conversation for its owner's private thread in this room. Kept apart so nothing
  /// said privately can reach a reply everyone reads.
  privateConversationId String?    @map("private_conversation_id")
  /// The newest message seq the private thread has read (it reads shared messages too).
  privateSeenSeq        Int        @default(0) @map("private_seen_seq")
  /// The newest message seq this person has read.
  readSeq               Int        @default(0) @map("read_seq")
  /// A person's own settings for a room with other people (node/trust.ts): `{ trust: { everyone, people: { accountId: … } },
  /// budget, away: { until, note, since }, shareable: [{ kind, id, spaceId, title }] }`. Empty for nodes.
  prefs                 Json       @default("{}")
  joinedAt              DateTime   @default(now()) @map("joined_at")
  room                  NodeRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  node                  NodeAgent? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([roomId, handle])
  @@index([userId])
  @@index([nodeId])
  @@map("node_room_members")
}

/// Everything said in a room, including cards (approval, run, status).
model NodeMessage {
  id            String   @id @default(uuid())
  roomId        String   @map("room_id")
  seq           Int
  /// The author's account: the person, or the node's owner.
  userId        String   @map("user_id")
  /// human | node | system
  authorKind    String   @map("author_kind")
  authorNodeId  String?  @map("author_node_id")
  /// text | approval | run | status | error | plan
  kind          String   @default("text")
  body          String   @default("")
  /// Card data: tool chips, held proposals, run state.
  data          Json     @default("{}")
  /// Empty: everyone in the room. Otherwise only these accounts (and their nodes) see it.
  visibleTo     String[] @default([]) @map("visible_to")
  /// Resolved mentions: `[{ kind: "human" | "node", id }]`.
  mentions      Json     @default("[]")
  /// The person's message this bot message descends from; bot budgets count from it.
  rootMessageId String?  @map("root_message_id")
  botDepth      Int      @default(0) @map("bot_depth")
  clientId      String?  @map("client_id")
  /// A card that belongs inside a plan card (node/plans.ts): shown there, not in the timeline or unread counts.
  planId        String?  @map("plan_id")
  createdAt     DateTime @default(now()) @map("created_at")
  room          NodeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, seq])
  @@unique([roomId, clientId])
  @@index([rootMessageId])
  @@map("node_messages")
}

/// A node's work on a computer: the Ensemble job it started, followed until it ends and reported back.
model NodeRun {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  nodeId     String    @map("node_id")
  roomId     String    @map("room_id")
  /// The run card in the room.
  messageId  String?   @map("message_id")
  jobId      String    @unique @map("job_id")
  taskId     String    @map("task_id")
  /// The agent session the run belongs to: its first run's job id. The node of the session's first node run owns it.
  sessionId  String?   @map("session_id")
  /// What the node asked the agent to do, for session summaries.
  prompt     String?
  /// Started by the node itself (node/sessions.ts): its task is internal and stays off the board.
  direct     Boolean   @default(false)
  /// The job status last seen; `steered` when a newer message in the session took over.
  status     String    @default("queued")
  /// The plan step this run does (node/plans.ts): its end wakes the node for that step.
  planId     String?   @map("plan_id")
  planStep   String?   @map("plan_step")
  reportedAt DateTime? @map("reported_at")
  /// The plan step's attempt this run belongs to: a late end from an earlier attempt changes nothing.
  attempt    Int       @default(1)
  /// Run settings: { requested, resolved, observed } with agent, model, effort, context, fast
  /// (node/settings.ts). observed values are "not_reported" when the engine does not say.
  settings   Json?
  /// What the watchdog already raised for this run (node/watchdog.ts): { <condition>: ISO time }, so each
  /// condition reaches the node once.
  watchdog   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  room       NodeRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([nodeId, status])
  @@index([planId])
  @@map("node_runs")
}

/// What happened to one of a node's agent sessions (node/session-queue.ts): a message queued, a steer, a
/// replacement, a stop, the queue reordered or a message taken out of it, a question answered, a watchdog
/// attention. From the node's tools (chat), its owner's session card (card) or the watchdog. The node's work
/// board reads it, so the node is never surprised by what its owner did on the card.
model NodeSessionEvent {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  nodeId    String    @map("node_id")
  /// The session's id: its first run's job id.
  sessionId String    @map("session_id")
  /// The run it concerns, when one: the new run, the stopped one, the one taken out of the queue.
  jobId     String?   @map("job_id")
  /// queue | steer | replace | stop | reorder | cancel | answer | attention | adopt
  action    String
  /// owner | node | watchdog
  actor     String
  /// chat | card | watchdog
  via       String
  detail    Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  node      NodeAgent @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@index([sessionId, createdAt])
  @@map("node_session_events")
}

/// One node turn: why it ran, how it ended. Queued rows left by a restart run again.
model NodeTurn {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  nodeId           String    @map("node_id")
  roomId           String?   @map("room_id")
  /// mentioned | dm | lead | run | approval | plan | request (a peer request) | answer, disclose (the owner's answer to a disclosure card)
  reason           String
  /// The owner's private thread in the room rather than the shared one.
  private          Boolean   @default(false)
  triggerMessageId String?   @map("trigger_message_id")
  /// Extra text for the turn (a finished run's result).
  note             String?
  /// The plan (its card's message id) this turn works on, and the step when it is a worker's.
  planId           String?   @map("plan_id")
  planStep         String?   @map("plan_step")
  /// Earlier tries of the same turn that the model's rate limit cut off.
  attempt          Int       @default(0)
  /// A retry waits until then.
  runAfter         DateTime? @map("run_after")
  /// The lane it runs in (node/lanes.ts): conv:<room>:<s|p> for conversation, work:<plan>:<step> for
  /// work. Turns run in order within a lane and in parallel across lanes. Null: derived (legacy rows).
  lane             String?
  /// owner: the answer goes only to the owner (DM, private thread, plan work). room: other people read
  /// the answer, so only room-safe context is reachable. Set by where the output goes, never widened.
  audience         String    @default("owner")
  /// The Ensemble space the turn works in. Null: the node's home space.
  spaceId          String?   @map("space_id")
  /// Idempotency for a turn enqueued by an outbox effect.
  operationId      String?   @unique @map("operation_id")
  /// Set when the turn first dispatched a tool that changes something: from then on it is not
  /// aborted to coalesce a new message, and a restart reconciles it instead of running it again.
  sideEffectsAt    DateTime? @map("side_effects_at")
  /// Tools the turn ran, written as each one ends: [{ name, state, summary }]. A restart reads them.
  receipts         Json      @default("[]")
  /// The peer request this turn answers or plans (node/peer-requests.ts): a mission it makes carries `requestedBy`.
  peerRequestId    String?   @map("peer_request_id")
  /// For a turn done for someone other than the owner: { data, billing, executionDevice, approver, askedBy } account ids.
  principals       Json      @default("{}")
  /// The first turn this one continues: a retry after a rate limit or a resume after a restart keeps
  /// that turn's operation and peer request through it.
  originTurnId     String?   @map("origin_turn_id")
  /// queued | running | done | failed
  status           String    @default("queued")
  model            String?
  credits          Float?
  error            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  finishedAt       DateTime? @map("finished_at")
  node             NodeAgent @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([nodeId, createdAt])
  @@map("node_turns")
}

/// A question, share, review or work request from one person in a room to another, through the other
/// person's lead (node/peer-requests.ts). The requester sees its status and public answers; the target
/// owner sees everything and decides. Work and reviews never start before the target owner accepts.
model NodePeerRequest {
  id            String    @id @default(uuid())
  roomId        String    @map("room_id")
  fromAccountId String    @map("from_account_id")
  /// The requester's node when it relayed the request for them.
  fromNodeId    String?   @map("from_node_id")
  toAccountId   String    @map("to_account_id")
  /// The target person's lead when the request was made.
  toNodeId      String    @map("to_node_id")
  /// question | share | review | work
  kind          String
  text          String
  /// [{ kind, id, title }]: tasks, pages, files or links the request names.
  refs          Json      @default("[]")
  /// A review's pinned candidate: { repo?, commit?, url? }.
  candidate     Json?
  /// open | answered | awaiting_owner | approved | declined | done | cancelled
  status        String    @default("open")
  /// The public answer, a decline note, or the result line when the work ended.
  answer        String?
  missionId     String?   @map("mission_id")
  /// The public card in the room, and the target owner's private card.
  cardId        String?   @map("card_id")
  ownerCardId   String?   @map("owner_card_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  decidedAt     DateTime? @map("decided_at")
  room          NodeRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([toAccountId, status])
  @@map("node_peer_requests")
}

/// What a node keeps between conversations. The owner sees, edits and deletes every row.
model NodeMemory {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  nodeId    String    @map("node_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  node      NodeAgent @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("node_memories")
}

/// Work a node owns (node/missions.ts): a crew plan, or a job the node does itself. Its id is its card's
/// message id, so `planId` everywhere names it. Steps are rows in node_steps; the card's data is a view.
model NodeMission {
  id            String     @id
  /// The owner: whose access, credits and computer the work uses unless principals say otherwise.
  userId        String     @map("user_id")
  leadNodeId    String     @map("lead_node_id")
  /// Where the lead was asked, and so where it reports.
  originRoomId  String     @map("origin_room_id")
  originPrivate Boolean    @default(false) @map("origin_private")
  /// The lead's turn that made it: its reply opens the card.
  leadTurnId    String?    @map("lead_turn_id")
  /// plan: a crew plan. self: one step the node does itself (node_work_start).
  kind          String     @default("plan")
  /// 1: migrated from the plan card's JSON (steps keep their old meaning). 3: this table.
  contract      Int        @default(3)
  /// draft | running | reporting | succeeded | partially_completed | failed | stopped
  status        String     @default("draft")
  revision      Int        @default(0)
  /// Compare-and-set counter for every change.
  version       Int        @default(0)
  goal          String?
  /// { computer, folder, repos, branch, publish, environment, agent, model, effort, context, substitution, order, notes }
  constraints   Json       @default("{}")
  /// [{ id, text, acceptance: [{ id, text, mandatory }], evidence, status }]
  requirements  Json       @default("[]")
  /// [{ requirementId, reason }]
  deferred      Json       @default("[]")
  /// The Ensemble space the work lives in. Null: the owner's home space.
  spaceId       String?    @map("space_id")
  /// { accountId, nodeId?, roomId? } when someone other than the owner asked for it.
  requestedBy   Json?      @map("requested_by")
  /// { roomId, audience } where the result goes, when not the origin.
  deliverTo     Json?      @map("deliver_to")
  /// { data, billing, executionDevice, approver }: account ids; empty means the owner for all four.
  principals    Json       @default("{}")
  /// { id, runId, title, notify } when a routine's occurrence started it (node/routines.ts).
  routine       Json?
  /// The lead was told the outcome (its report turn ran).
  reportedAt    DateTime?  @map("reported_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  endedAt       DateTime?  @map("ended_at")
  steps         NodeStep[]

  @@index([userId, status])
  @@index([leadNodeId, status])
  @@index([originRoomId])
  @@map("node_missions")
}

/// One step of a mission. Execution (status) and result (outcome) are separate; attempts keep history.
model NodeStep {
  missionId      String      @map("mission_id")
  /// s1-ab12cd: unique in its mission; turns, runs and cards name it as planStep.
  id             String
  position       Int
  nodeId         String      @map("node_id")
  handle         String
  name           String
  /// build | verify | write | research | other
  kind           String      @default("other")
  /// node: the step's node takes turns for it. self: the lead's own work. session: dispatched straight to an agent session.
  executor       String      @default("node")
  brief          String
  /// Step ids that must be done (or passed) before this one starts.
  after          String[]    @default([])
  /// For a verify step: the build step it checks.
  verifies       String?
  /// For an integration step (a build): the build steps whose worktrees or snapshots it brings into the folder (B13).
  integrates     String[]    @default([])
  requirementIds String[]    @default([]) @map("requirement_ids")
  /// Agent run settings the lead gave: { agent, model, effort, context }.
  run            Json?
  /// waiting | working | done | blocked | skipped | stopped
  status         String      @default("waiting")
  /// unknown | done | pass | fail | blocked | unverified: the current attempt's result.
  outcome        String      @default("unknown")
  /// The current attempt: 1, 2, …
  attempt        Int         @default(1)
  /// Earlier and current attempts: [{ n, reason, outcome, summary, checks, candidate, signature, startedAt, endedAt }]
  attempts       Json        @default("[]")
  /// The current attempt's StepReport (node/report.ts).
  report         Json?
  /// One-paragraph result shown on the card.
  result         String?
  progress       String?
  /// The agent session this step's runs use, once it has one.
  sessionId      String?     @map("session_id")
  /// The step node's own assistant conversation for this step (work lanes never share the room's).
  conversationId String?     @map("conversation_id")
  /// The worker was asked once to report; another miss makes the attempt unverified.
  nudged         Boolean     @default(false)
  startedAt      DateTime?   @map("started_at")
  endedAt        DateTime?   @map("ended_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  mission        NodeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([missionId, id])
  @@unique([missionId, position])
  @@index([nodeId, status])
  @@map("node_steps")
}

/// Effects of committed mission changes (node/outbox.ts): delivered at least once, applied once by the
/// consumer through operationId (a turn's or job's unique operation_id).
model NodeOutbox {
  id           String    @id @default(uuid())
  operationId  String    @unique @map("operation_id")
  missionId    String?   @map("mission_id")
  /// turn | report | refresh | expire_decisions | notify
  kind         String
  payload      Json      @default("{}")
  availableAt  DateTime  @default(now()) @map("available_at")
  attempts     Int       @default(0)
  claimedUntil DateTime? @map("claimed_until")
  deliveredAt  DateTime? @map("delivered_at")
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([deliveredAt, availableAt])
  @@index([missionId])
  @@map("node_outbox")
}

/// What a plan step (or another holder, such as the browser broker) uses on a computer, so two never use it
/// at once (node/claims.ts, B13): a folder's checkout, a git worktree, a branch, a development-server port, a
/// browser profile or tab. One holder at a time; the others wait in line, in the order they asked, and the
/// next one gets it when the holder lets go. A claim never refuses work.
model ResourceClaim {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// checkout | worktree | branch | port | browser_profile | browser_tab
  kind      String
  /// The resource, scoped to its computer: `<deviceId>:<folder>`, `<deviceId>:<folder>:<worktree>`, `<deviceId>:<port>`.
  key       String
  /// Who holds it or waits for it: `step:<missionId>:<stepId>`, or the caller's own id (a job, a browser session).
  holder    String
  /// held | waiting
  state     String   @default("held")
  missionId String?  @map("mission_id")
  stepId    String?  @map("step_id")
  /// What the holder needs back: a waiting step's { attempt, reason }; a worktree's { name, branch, detached, reuse }.
  data      Json     @default("{}")
  /// The order holders asked in: the first one waiting gets the resource next.
  sequence  BigInt   @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, key, holder])
  @@index([kind, key, state])
  @@index([holder])
  @@index([missionId])
  @@map("resource_claims")
}

/// A secret a person saved on their own computer for its agent runs (lib/run-secrets.ts): given to the
/// runs there as an environment variable, never to a model. Encrypted with that computer's key.
/// Ensemble on the web never stores one; the value only passes through on its way to the computer.
model RunSecret {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// An environment variable name, such as GITHUB_TOKEN.
  name      String
  value     String
  /// Origins it may be sent to by reference (secret_http, git); null: nowhere (credentials/secret-store.ts).
  allow     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("run_secrets")
}

/// Work a node does on a schedule, on an Ensemble event or on a webhook (node/routines.ts, B14).
model NodeRoutine {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  nodeId      String           @map("node_id")
  /// Where it reports: the node's DM, or a crew only its owner reads.
  roomId      String           @map("room_id")
  title       String
  /// prompt: the node does `instruction` as its own work. plan: `template` (a node_plan input) runs as a plan.
  action      String           @default("prompt")
  instruction String?
  template    Json?
  /// schedule | event | webhook (any routine can also be run now)
  trigger     String           @default("schedule")
  /// Five-field cron in `timezone` (schedule).
  cron        String?
  timezone    String           @default("UTC")
  /// { on: task | page, actions?, space?, windowSeconds } (event)
  event       Json?
  /// sha256 of the webhook token (webhook); the token is shown once.
  hookHash    String?          @map("hook_hash")
  /// always | needed | never: when its result is posted.
  notify      String           @default("always")
  /// active | paused
  status      String           @default("active")
  nextRunAt   DateTime?        @map("next_run_at")
  lastRunAt   DateTime?        @map("last_run_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  node        NodeAgent        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  runs        NodeRoutineRun[]

  @@index([userId])
  @@index([status, trigger, nextRunAt])
  @@map("node_routines")
}

/// One occurrence of a routine. The key is unique per routine, so each occurrence starts once.
model NodeRoutineRun {
  id            String      @id @default(uuid())
  routineId     String      @map("routine_id")
  userId        String      @map("user_id")
  /// at:<scheduled time> | event:<window> | hook:<window> | manual:<id>
  occurrenceKey String      @map("occurrence_key")
  /// schedule | event | webhook | manual
  trigger       String
  /// What happened (events gathered in its window, webhook deliveries): information, never instructions.
  payload       Json?
  /// pending | starting | started | skipped | failed
  status        String      @default("pending")
  dueAt         DateTime    @default(now()) @map("due_at")
  missionId     String?     @map("mission_id")
  error         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  startedAt     DateTime?   @map("started_at")
  routine       NodeRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, occurrenceKey])
  @@index([status, dueAt])
  @@map("node_routine_runs")
}

/// A file the worker of a run attached for its owner (evidence/, docs/32 §7): a screenshot, image, video,
/// trace, report, log or file. On a computer the bytes stay in the run's evidence folder; on the web they
/// are in the blob store Files uses, or on the row when this server keeps uploads in the database.
/// Only the account it belongs to reads it.
model JobEvidence {
  /// Made by the computer, so a repeated upload finds the same row.
  id            String       @id @default(uuid())
  /// The account whose computer ran the job (its runner, else the space's owner), or whose node captured it.
  userId        String       @map("user_id")
  /// The run that attached or captured it; null for a node's own capture (`nodeId`, `operation`).
  jobId         String?      @map("job_id")
  /// screenshot | image | video | trace | report | log | file
  kind          String
  /// The file's name (no folders).
  name          String
  /// The type sniffed from the bytes, never the sender's word.
  mime          String
  size          Int
  sha256        String
  /// Where the bytes are: the blob key (evidence/<userId>/<jobId>/<id>) on the web, the file's name in the
  /// run's evidence folder on a computer.
  storageKey    String       @map("storage_key")
  /// The bytes, when this server keeps uploads in the database (no blob store).
  bytes         Bytes?
  /// Kept on the computer only: evidence upload is off there, so the web has its name and size, not the bytes.
  local         Boolean      @default(false)
  caption       String?
  /// The mission requirement it supports, when the worker named one.
  requirementId String?      @map("requirement_id")
  /// A node's own capture (its device tools, no job): the node, and the tool operation on the computer.
  nodeId        String?      @map("node_id")
  operation     String?
  /// Kept on the computer for the owner to preview first (a secret on screen, a desktop app's window,
  /// a preview-first site): never sent to a model or shown in a chat until the owner releases it.
  held          Boolean      @default(false)
  holdReason    String?      @map("hold_reason")
  /// The computer that keeps the file (held, or evidence upload off there).
  deviceId      String?      @map("device_id")
  /// A video's poster or small preview image: the video's evidence id, and `poster` or `preview`.
  variantOf     String?      @map("variant_of")
  variant       String?
  /// What capture measured: width, height, durationMs, fps, frames, codec.
  details       Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  job           WorkspaceJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([userId, createdAt])
  @@index([nodeId, createdAt])
  @@index([variantOf])
  @@map("job_evidence")
}
